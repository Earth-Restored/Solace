@page "/login.live.com/ppsecure/InlineConnect.srf"
@using System.Diagnostics.CodeAnalysis
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using Solace.Common.Asp.Auth
@using Solace.Common.Constants
@using Solace.Db.Earth
@using Solace.Db.Earth.Utils
@using Solace.StaticData
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<EarthDbContext> EarthDbFactory
@inject IOptions<AuthSettings> AuthSettings
@inject CryptoSecrets CryptoSecrets
@inject StaticDataProvider StaticData

<HeadContent>
    <meta charset="UTF-8">
    <title>WebPortal Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="css/form.css" />
</HeadContent>

<div class="minecraft-bg">
    <div class="sky-sun"></div>
    <div class="cloud cloud-1"></div>
    <div class="cloud cloud-2"></div>
    <div class="cloud cloud-3"></div>
    <div class="cloud cloud-4"></div>
    <div class="cloud cloud-5"></div>
    <div class="cloud cloud-6"></div>

    <div class="hill hill-back"></div>
    <div class="hill hill-front"></div>
</div>

<div class="container">
    <AuthorizeView>
        <NotAuthorized>
            <h1 id="formTitle">WebPortal Authentication</h1>

            <a href="/login" class="bp-submit-btn">
                Log In
            </a>
        </NotAuthorized>

        <Authorized>
            @if (!CanCreateProfile)
            {
                <h1 id="formTitle">Access Denied</h1>
                @if (!string.IsNullOrEmpty(Email))
                {
                    <p class="subtitle" style="margin-bottom: 6px; opacity: 0.85;">Logged in as <strong>@Email</strong></p>
                }
                <p class="subtitle" style="color: #ff5252; margin-bottom: 20px;">
                    This account does not have permission to create profiles.
                </p>
                <div style="margin-top: 20px; text-align: center;">
                    <a href="/logout?returnUrl=@(Uri.EscapeDataString("/login.live.com/ppsecure/InlineConnect.srf"))" style="color: #fff; text-decoration: underline;">
                        Sign out
                    </a>
                </div>
            }
            else if (SelectedProfile is not null)
            {
                <h1 id="formTitle">Logging in...</h1>
                <p class="subtitle">Welcome, @SelectedProfile.Username! Launching game...</p>

                <script>
                                external.Property('DAToken', `<EncryptedData xmlns="http://www.w3.org/2001/04/xmlenc#" Id="BinaryDAToken0"><CipherData><CipherValue>@HandoffToken</CipherValue></CipherData></EncryptedData>`);
                                external.Property('DAStartTime', '@(HandoffTokenValidity!.Value.IssuedStr)');
                                external.Property('DAExpires', '@(HandoffTokenValidity!.Value.ExpiresStr)');
                                external.Property('DASessionKey', '@CryptoSecrets.LoginUserTokenSessionKeyBase64');
                                external.Property('FirstName', '@SelectedProfile.Username');
                                external.Property('LastName', '@SelectedProfile.Username');
                                external.Property('SigninName', '@SelectedProfile.Username');
                                external.Property('Username', '@SelectedProfile.Username');
                                external.Property('CID', '@SelectedProfile.Id');
                                external.Property('PUID', '@SelectedProfile.Id');

                                external.FinalNext();
                </script>
            }
            else if (Profiles is null)
            {
                <h1 id="formTitle">Loading</h1>
                <p class="subtitle">Fetching your profiles...</p>
            }
            else
            {
                <h1 id="formTitle">Select Profile</h1>

                @if (!string.IsNullOrEmpty(Email))
                {
                    <p class="subtitle" style="margin-bottom: 12px; opacity: 0.85;">Logged in as <strong>@Email</strong></p>
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="bp-status error" role="alert" style="margin-bottom: 15px;">
                        @ErrorMessage
                    </div>
                }

                <div class="profile-list">
                    @foreach (var profile in Profiles)
                    {
                        var pct = profile.LevelProgressPercentage ?? 1.0f;
                        var circumference = 119.38f; // 2 * pi * r (r=19)
                        var dashoffset = circumference * (1.0f - pct);

                        <div class="profile-card">
                            <div class="profile-info">
                                <div class="level-badge" title="Level @profile.Level (@(profile.LevelProgressPercentage.HasValue ? $"{(int)(profile.LevelProgressPercentage.Value * 100)}%" : "MAX"))">
                                    <svg viewBox="0 0 48 48" class="level-svg">
                                        <circle class="level-bg" cx="24" cy="24" r="19" />
                                        <circle class="level-progress" cx="24" cy="24" r="19" style="stroke-dasharray: 119.38; stroke-dashoffset: @dashoffset;" />
                                    </svg>
                                    <span class="level-text">@profile.Level</span>
                                </div>

                                <div class="profile-details">
                                    <span class="profile-name">@profile.Username</span>
                                    <div class="profile-rubies" title="@profile.Rubies Rubies">
                                        <svg class="ruby-icon" viewBox="0 0 16 16">
                                            <path d="M5 2h6l5 5-8 7-8-7z" />
                                        </svg>
                                        <span>@profile.Rubies</span>
                                    </div>
                                </div>
                            </div>

                            <form method="post" @formname="@($"select_profile_{profile.Id}")" @onsubmit="() => SelectProfile(profile.Id)" class="profile-action">
                                <AntiforgeryToken />
                                <button type="submit" class="bp-submit-btn profile-play-btn">
                                    Play
                                </button>
                            </form>
                        </div>
                    }
                </div>

                @if (Profiles.Count < 3)
                {
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 20px 0;" />
                    <form method="post" @formname="create_profile_form" @onsubmit="CreateProfile">
                        <AntiforgeryToken />
                        <div class="bp-form-row">
                            <label for="newUsername">New Profile Username <span class="required">*</span></label>
                            <input id="newUsername" name="NewUsername" type="text" @bind-value="NewUsername" placeholder="Username" required minlength="@AccountConstants.UsernameLengthMin" maxlength="@AccountConstants.UsernameLengthMax" pattern="@AccountConstants.GetUsernameRegex()" title="Lowercase letters, numbers, underscore, and colon only" />
                        </div>
                        <button type="submit" class="bp-submit-btn" style="background-color: #2e7d32;">
                            Create (@(Profiles.Count + 1) / 3)
                        </button>
                    </form>
                }
                else
                {
                    <p class="subtitle" style="color: #ffb74d;">Maximum profiles reached (3/3).</p>
                }

                <div class="logout-wrapper">
                    <a class="logout-link" href="/logout?returnUrl=@(Uri.EscapeDataString("/login.live.com/ppsecure/InlineConnect.srf"))">Sign out</a>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private List<ProfileDto>? Profiles;
    private ProfileDto? SelectedProfile;
    private string? HandoffToken;
    private ValidityDatePair? HandoffTokenValidity;

    [SupplyParameterFromForm]
    private string? NewUsername { get; set; }

    private string? ErrorMessage;

    private long? AccountId => long.TryParse(HttpContextAccessor.HttpContext?.User.FindFirst("sub")?.Value, out var id) ? id : null;
    private string? Email => HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;

    private bool CanCreateProfile => HttpContextAccessor.HttpContext?.User.HasClaim("can_create_profile", "true") ?? false;

    protected override async Task OnInitializedAsync()
    {
        if (AccountId is not null && CanCreateProfile)
        {
            await LoadProfilesAsync();
        }
    }

    private async Task LoadProfilesAsync()
    {
        if (AccountId is null)
        {
            return;
        }

        await using var earthDb = await EarthDbFactory.CreateDbContextAsync();
        Profiles = await earthDb.Profiles
            .AsNoTracking()
            .Where(profile => profile.WebPortalAccountId == AccountId.Value)
            .Select(profile => new { profile.Id, profile.Username, profile.Level, profile.Experience, PurchasedRubies = profile.Rubies.Purchased, EarnedRubies = profile.Rubies.Earned })
            .AsAsyncEnumerable()
            .Select(profile => new ProfileDto(profile.Id, profile.Username!, profile.Level, GetLevelProgressPercentage(profile.Level, profile.Experience, StaticData.Levels), profile.PurchasedRubies + profile.EarnedRubies))
            .ToListAsync();
    }

    private void SelectProfile(Guid profileId)
    {
        if (!CanCreateProfile)
        {
            ErrorMessage = "Your account does not have permission to create profiles.";
            return;
        }

        var profile = Profiles?.FirstOrDefault(p => p.Id == profileId);
        if (profile is null)
        {
            return;
        }

        SelectedProfile = profile;
        CreateToken();
    }

    private async Task CreateProfile()
    {
        ErrorMessage = null;

        if (!CanCreateProfile)
        {
            ErrorMessage = "Your account does not have permission to create profiles.";
            return;
        }

        if (!AccountId.HasValue)
        {
            ErrorMessage = "Authentication session error. Please re-login.";
            return;
        }

        if (Profiles is not null && Profiles.Count >= 3)
        {
            ErrorMessage = "You cannot have more than 3 profiles.";
            return;
        }

        NewUsername = NewUsername?.Trim();

        if (string.IsNullOrWhiteSpace(NewUsername) || NewUsername.Length < AccountConstants.UsernameLengthMin || NewUsername.Length > AccountConstants.UsernameLengthMax)
        {
            ErrorMessage = $"Username must be between {AccountConstants.UsernameLengthMin} and {AccountConstants.UsernameLengthMax} characters.";
            return;
        }

        if (!AccountConstants.GetUsernameRegex().IsMatch(NewUsername))
        {
            ErrorMessage = $"Username must only contain {AccountConstants.UsernameAllowedCharacters}.";
            return;
        }

        await using var earthDb = await EarthDbFactory.CreateDbContextAsync();

        await using var transaction = await earthDb.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);

        if ((await earthDb.Profiles.CountAsync(profile => profile.WebPortalAccountId == AccountId.Value)) >= 3)
        {
            ErrorMessage = "You cannot have more than 3 profiles.";
            return;
        }

        var exists = await earthDb.Profiles.AnyAsync(profile => profile.Username == NewUsername);
        if (exists)
        {
            ErrorMessage = "Username is already taken. Please choose another.";
            return;
        }

        var newProfile = await earthDb.GetOrCreateAccount(Guid.CreateVersion7(), AccountId.Value);
        newProfile.Username = NewUsername;

        try
        {
            await earthDb.SaveChangesAsync();
            await transaction.CommitAsync();
        }
        catch (DbUpdateException exception) when (exception.IsUniqueConstraintViolation)
        {
            ErrorMessage = "Username is already taken. Please choose another.";
            return;
        }

        SelectedProfile = new ProfileDto(newProfile.Id, newProfile.Username, newProfile.Level, GetLevelProgressPercentage(newProfile.Level, newProfile.Experience, StaticData.Levels), newProfile.Rubies.Total);
        CreateToken();
    }

    private void CreateToken()
    {
        if (SelectedProfile is null)
        {
            return;
        }

        HandoffTokenValidity = ValidityDatePair.Create(AuthSettings.Value.UserTokenValidityMinutes);
        var token = new UserToken(
            SelectedProfile.Id,
            SelectedProfile.Username
        );
        HandoffToken = JwtUtils.Sign(token, CryptoSecrets.LoginUserTokenSecret, HandoffTokenValidity.Value);
    }

    public static int? GetRequiredExperienceForNextLevel(int level, PlayerLevels levels)
    {
        var levelIndex = int.Max(level - 1, 0);
        return levelIndex < levels.Levels.Length ? levels.Levels[levelIndex].ExperienceRequired : null;
    }

    public static float? GetLevelProgressPercentage(int level, int experience, PlayerLevels levels)
    {
        var requiredExperienceNull = GetRequiredExperienceForNextLevel(level, levels);

        if (requiredExperienceNull is not { } requiredExperience)
        {
            return null;
        }
        else if (requiredExperience <= 0f)
        {
            return 1f;
        }

        return float.Clamp(experience / (float)requiredExperience, 0f, 1f);
    }

    private sealed class ProfileDto
    {
        [SetsRequiredMembers]
        public ProfileDto(Guid id, string username, int level, float? levelProgressPercentage, int rubies)
        {
            Id = id;
            Username = username;
            Level = level;
            LevelProgressPercentage = levelProgressPercentage;
            Rubies = rubies;
        }

        public required Guid Id { get; set; }

        public required string Username { get; set; }

        public required int Level { get; set; }

        public required float? LevelProgressPercentage { get; set; }

        public required int Rubies { get; set; }
    }
}