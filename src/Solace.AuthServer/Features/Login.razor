@page "/"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Solace.Db.Earth
@using PlayerProfile = Solace.Db.Earth.Models.Account
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<EarthDbContext> EarthDbFactory

<AuthorizeView>
    <Authorized>
        @if (!string.IsNullOrEmpty(HandoffToken))
        {
            <!-- 3. Token Generated! Execute JS to hand it to the game and close the auth window -->
            <div class="alert alert-success">
                Login successful! Returning to the game...
            </div>
            <script>
                        // Pass the token to the game client
                        extern.blabla("@HandoffToken");

                        // Close the browser popup/window
                        window.close();
            </script>
        }
        else if (Profiles == null)
        {
            <p>Loading your characters...</p>
        }
        else
        {
            <!-- 2. Present Profile Selection UI -->
            <a href="/logout" class="btn btn-success">Sign out</a>
            <h3>Select a Profile to Play</h3>
            <h3>@AccountId</h3>
            <h3>@Email</h3>
            <div class="profile-grid">
                @foreach (var profile in Profiles)
                {
                    <div class="card">
                        <h4>@profile.Username</h4>
                        <form method="post" @formname="@($"select_profile_{profile.Id}")" @onsubmit="() => SelectProfile(profile.Id)">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Play as @profile.Username</button>
                        </form>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <!-- 1. Start the flow -->
        <p>You must authenticate your account to play.</p>
        <a href="/login" class="btn btn-success">Sign In via Browser</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PlayerProfile>? Profiles;
    private string? HandoffToken;

    // Helper to get AccountId safely from the current ClaimsPrincipal
    private long? AccountId => long.TryParse(HttpContextAccessor.HttpContext?.User.FindFirst("sub")?.Value, out var id) ? id : null;
    private string? Email => HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;

    protected override async Task OnInitializedAsync()
    {
        if (AccountId.HasValue && HandoffToken is null)
        {
            await using var earthDb = await EarthDbFactory.CreateDbContextAsync(); 
            Profiles = await earthDb.Accounts
                .AsNoTracking()
                .Where(account => account.WebPortalAccountId == AccountId.Value)
                .ToListAsync();
        }
    }

    private async Task SelectProfile(Guid profileId)
    {
        // 1. Verify the profile belongs to this AccountId (security check)
        var profile = Profiles?.FirstOrDefault(p => p.Id == profileId);
        if (profile == null || !AccountId.HasValue) return;

        // 2. Generate your custom game server token using the selected profile
        HandoffToken = "abc";//TokenGenerator.CreateToken(AccountId.Value, profile.Id);

        // 3. We have what we need. Kill the web cookie session so the user
        // doesn't remain logged into the web app in the background.
        if (HttpContextAccessor.HttpContext != null)
        {
            await HttpContextAccessor.HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }
    }
}