@using HomagGroup.Blazor3D.Enums
@using HomagGroup.Blazor3D.Lights
@using HomagGroup.Blazor3D.Maths
@using HomagGroup.Blazor3D.Scenes
@using HomagGroup.Blazor3D.Settings
@using HomagGroup.Blazor3D.Viewers
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Solace.AdminPanel.Data
@using Solace.AdminPanel.Utils
@using Solace.BuildplateImporter
@using Solace.BuildplateRenderer
@using Solace.Common
@using Solace.Common.Utils
@using Solace.DB.Earth
@using Solace.EventBus.Client
@using Solace.ObjectStore.Client

@inject IJSRuntime JSRuntime
@inject IDbContextFactory<ApplicationDbContext> ApplicationDbFactory
@inject IDbContextFactory<EarthDbContext> EarthDbFactory
@inject EventBusClient EventBusClient
@inject ObjectStoreClient ObjectStoreClient
@inject IConfiguration Configuration
@inject ILogger<BuildplatePreview> Logger
@implements IAsyncDisposable

<div @ref="_previewContainer" class="bg-dark text-secondary d-flex align-items-center justify-content-center position-relative preview-container" style="height: 220px; overflow: hidden;">
    @if (_isPreviewLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center w-75">
            <div class="text-info mb-2 fw-bold text-center small">
                @(_progressStatus ?? "Loading 3D preview...")
            </div>
            <div class="progress w-100 bg-secondary bg-opacity-25" style="height: 4px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: @(_currentProgress * 100)%; transition: width 0.2s ease;" aria-valuenow="@double.Round(_currentProgress * 100)" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>

            @if (_currentProgress > 0)
            {
                <div class="text-info small mt-1" style="font-size: 0.75rem;">
                    @(double.Round(_currentProgress * 100, 1))%
                </div>
            }
        </div>
    }
    else if (_isPreviewFailed)
    {
        <div class="text-danger d-flex flex-column align-items-center">
            <i class="bi bi-x-circle fs-3 mb-1"></i>
            <span class="small fw-bold">Preview unavailable</span>
        </div>
    }
    else if (_previewDataUri is not null)
    {
        <div class="w-100 h-100">
            <Viewer @ref="_viewer3D" ViewerSettings="@_settings" Scene="@_scene" />
        </div>
    }

    <span class="position-absolute top-0 start-0 m-2 badge bg-info text-dark">
        @DisplayScale
    </span>
    <span class="position-absolute top-0 end-0 m-2 badge @(IsNight ? "bg-secondary" : "bg-info text-dark")">
        @(IsNight ? "Night" : "Day")
    </span>

    @if (!_isPreviewLoading)
    {
        <button class="btn btn-sm btn-light position-absolute bottom-0 start-0 m-2 opacity-75 hover-opacity-100" @onclick="RefreshPreviewAsync" title="Refresh Preview">
            <i class="bi bi-arrow-clockwise"></i>
        </button>

        if (_previewDataUri is not null)
        {
            <button class="btn btn-sm btn-light position-absolute bottom-0 end-0 m-2 opacity-75 hover-opacity-100" @onclick="ToggleFullscreen" title="Toggle Fullscreen">
                <i class="bi bi-arrows-fullscreen"></i>
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required Guid BuildplateId { get; set; }
    [Parameter, EditorRequired] public required bool IsTemplate { get; set; }
    [Parameter] public Guid? PlayerId { get; set; }
    [Parameter] public int Size { get; set; }
    [Parameter] public int BlocksPerMeter { get; set; }
    [Parameter] public bool IsNight { get; set; }
    [Parameter] public ResourcePackManager? ResourcePackManager { get; set; }

    private static SemaphoreSlim? _generationSemaphore;
    private static readonly Lock _semaphoreLock = new();

    private ElementReference _previewContainer;
    private Viewer? _viewer3D;
    private ViewerSettings _settings = new();
    private Scene _scene = new();

    private bool _isPreviewLoading = true;
    private bool _isPreviewFailed = false;
    private string? _previewDataUri;
    private bool _isModelImported = false;
    private bool _isCurrentlyLoadingTask = false;
    private IJSObjectReference? _jsModule;

    private double _targetProgress = 0;
    private double _currentProgress = 0;
    private string? _progressStatus;
    private CancellationTokenSource? _progressCts;

    private string DisplayScale
    {
        get
        {
            float scaleVal = 1f / BlocksPerMeter;
            return scaleVal >= 1 ? $"1:{scaleVal:0.##}" : $"{(1 / scaleVal):0.##}:1";
        }
    }

    protected override void OnInitialized()
    {
        _settings.ContainerId = $"viewer_{BuildplateId}";
        _scene.Add(new AmbientLight() { Intensity = 2 });
        _scene.Add(new DirectionalLight() { Intensity = 2 });
        _scene.BackGroundColor = IsNight ? "#070066" : "#3B69F5";

        if (_generationSemaphore is null)
        {
            lock (_semaphoreLock)
            {
                if (_generationSemaphore is null)
                {
                    var maxConcurrency = Configuration.GetValue<int>("BuildplatePreview:GenerationMaxConcurrency", 2);
                    if (maxConcurrency <= 0)
                    {
                        maxConcurrency = 2;
                    }

                    _generationSemaphore = new SemaphoreSlim(maxConcurrency, maxConcurrency);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Buildplates.razor.js");

            if (_previewDataUri is null && !_isPreviewFailed && _isPreviewLoading && !_isCurrentlyLoadingTask)
            {
                ResetProgress();
                _isCurrentlyLoadingTask = true;

                InvokeAsync(async () =>
                {
                    try
                    {
                        await Task.Run(async () => await LoadPreviewAsync());
                    }
                    finally
                    {
                        _isCurrentlyLoadingTask = false;
                        StateHasChanged();
                    }
                }).Forget();
            }
        }

        if (_viewer3D is not null)
        {
            var orbitTarget = new Vector3(0, 0f, 0);
            var cameraDistance = Size * 1.25f;
            _viewer3D.Camera.Position = new Vector3(-cameraDistance, cameraDistance, -cameraDistance);
            _viewer3D.Camera.LookAt = orbitTarget;
            _viewer3D.OrbitControls.TargetPosition = orbitTarget;

            if (_previewDataUri != null && !_isModelImported)
            {
                try
                {
                    await _viewer3D.Import3DModelAsync(new ImportSettings
                    {
                        Format = Import3DFormats.Gltf,
                        FileURL = _previewDataUri,
                    });
                    _isModelImported = true;
                }
                catch (ArgumentNullException exception) when (exception.ParamName == "jsObjectReference")
                {
                    Logger.LogDebug("Viewer JS reference not ready for {Id}, retrying next render...", BuildplateId);
                    await Task.Delay(200);
                    StateHasChanged();
                }
                catch (Exception exception)
                {
                    Logger.LogError(exception, "Failed to import GLB model into Blazor3D Viewer for {Id}", BuildplateId);
                    _isPreviewFailed = true;
                    _isModelImported = true;
                    StateHasChanged();
                }
            }
        }
    }

    private async Task RefreshPreviewAsync()
    {
        if (_isCurrentlyLoadingTask)
        {
            return;
        }

        ResetProgress();

        _isCurrentlyLoadingTask = true;

        _isPreviewLoading = true;
        _isPreviewFailed = false;
        _isModelImported = false;
        _previewDataUri = null;

        StateHasChanged();

        InvokeAsync(async () =>
        {
            try
            {
                await Task.Run(async () => await LoadPreviewAsync(getFromCache: false));
            }
            finally
            {
                _isCurrentlyLoadingTask = false;
                StateHasChanged();
            }
        }).Forget();
    }

    private void ResetProgress()
    {
        _progressCts?.Cancel();
        _progressCts?.Dispose();
        _progressCts = null;

        _targetProgress = 0;
        _currentProgress = 0;
        _progressStatus = "Initializing...";
    }

    private void UpdateProgress(ProgressReport report)
    {
        _targetProgress = double.Clamp(report.PercentComplete, 0, 1);

        if (report.StatusMessage is not null)
        {
            _progressStatus = report.StatusMessage;
        }

        if (_progressCts is null || _progressCts.IsCancellationRequested)
        {
            _progressCts = new CancellationTokenSource();
            _ = InterpolateProgressAsync(_progressCts.Token);
        }
    }

    private async Task InterpolateProgressAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (double.Abs(_currentProgress - _targetProgress) > 0.001)
                {
                    var diff = _targetProgress - _currentProgress;
                    var step = diff * 0.15;

                    if (double.Abs(step) < 0.01)
                    {
                        step = double.Sign(diff) * 0.01;
                    }

                    _currentProgress += step;

                    if ((diff > 0 && _currentProgress > _targetProgress) ||
                        (diff < 0 && _currentProgress < _targetProgress) ||
                        double.Abs(_currentProgress - _targetProgress) < 0.001)
                    {
                        _currentProgress = _targetProgress;
                    }

                    await InvokeAsync(StateHasChanged);
                }
                else if (_targetProgress >= 1.0)
                {
                    break;
                }

                await Task.Delay(100, token);
            }
        }
        catch (Exception ex) when (ex is TaskCanceledException || ex is ObjectDisposedException)
        {
        }
    }

    private async Task LoadPreviewAsync(bool getFromCache = true)
    {
        if (!Configuration.GetValue<bool>("BuildplatePreview:Enabled"))
        {
            _isPreviewLoading = false;
            return;
        }

        if (ResourcePackManager is null)
        {
            _isPreviewLoading = false;
            _isPreviewFailed = true;
            return;
        }

        ResetProgress();
        var progress = new Progress<ProgressReport>(UpdateProgress);

        _progressStatus = "Queued for generation, please wait";
        await InvokeAsync(StateHasChanged);

        if (_generationSemaphore is not null)
        {
            await _generationSemaphore.WaitAsync();
        }

        try
        {
            await using var importer = new Importer(await EarthDbFactory.CreateDbContextAsync(), EventBusClient, ObjectStoreClient, Logger)
            {
                OwnsEarthDb = true,
                OwnsEventBusClient = false,
                OwnsObjectStoreClient = false,
            };

            await using var dbContext = await ApplicationDbFactory.CreateDbContextAsync();
            var previewData = IsTemplate
                ? await importer.GetTemplateAdminPanelPreviewAsync(BuildplateId, dbContext, ResourcePackManager, progress: progress, getFromCache: getFromCache)
                : await importer.GetPlayerBuildplateAdminPanelPreviewAsync(PlayerId!.Value, BuildplateId, dbContext, ResourcePackManager, progress: progress, getFromCache: getFromCache);

            if (previewData is null)
            {
                _isPreviewFailed = true;
                return;
            }

            _previewDataUri = DataUtils.DataToUri(previewData.Value.AsSpan());
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Preview mesh generation failed for Buildplate ID {Id}", BuildplateId);
            _isPreviewFailed = true;
        }
        finally
        {
            _generationSemaphore?.Release();

            _progressCts?.Cancel();
            _isPreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleFullscreen()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("toggleFullscreen", _previewContainer);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _progressCts?.Cancel();
            _progressCts?.Dispose();

            if (_viewer3D is not null)
            {
                await _viewer3D.DisposeAsync();
            }

            if (_jsModule is not null)
            {
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Error during disposal of {Id}", BuildplateId);
        }
    }
}