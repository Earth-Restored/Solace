@page "/Roles"
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Client.Features.Common
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Common
@using Solace.WebPortal.Common.Features.Roles
@using System.Net.Http.Json
@attribute [Authorize(Policy = Permissions.EditRoles)]
@rendermode InteractiveWebAssembly
@inject HttpClient Http

<PageTitle>Roles - Solace</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Role Hierarchy</h2>
        <button class="btn btn-primary" @onclick="PrepareCreate">Create New Role</button>
    </div>

    @if (_roles is null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="d-none d-md-block">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Position</th>
                            <th>Color</th>
                            <th>Name</th>
                            <th>Permissions</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in _roles.OrderBy(r => r.Position))
                        {
                            var canManage = role.Position > _userMinPosition && (!role.IsBuiltIn || role.Name == RoleConstants.Default);
                            <tr style="border-left: 5px solid @role.Color">
                                <td>@role.Position</td>
                                <td>
                                    <div style="width: 20px; height: 20px; background:@role.Color; border-radius: 4px;"></div>
                                </td>
                                <td>
                                    <strong>@role.Name</strong>
                                    @if (role.Name == RoleConstants.Default)
                                    {
                                        <span class="badge bg-info ms-2">Default</span>
                                    }
                                    else if (role.IsBuiltIn)
                                    {
                                        <span class="badge bg-secondary ms-2">System</span>
                                    }
                                </td>
                                <td>
                                    @RenderPermissions(role)
                                </td>
                                <td>
                                    @RenderActions((role, canManage))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-md-none">
            @foreach (var role in _roles.OrderBy(r => r.Position))
            {
                var canManage = role.Position > _userMinPosition && (!role.IsBuiltIn || role.Name == RoleConstants.Default);

                <div class="card mb-3 shadow-sm border-0" style="border-left: 5px solid @role.Color">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@role.Name</strong>
                                @if (role.Name == RoleConstants.Default)
                                {
                                    <span class="badge bg-info ms-2">Default</span>
                                }
                                else if (role.IsBuiltIn)
                                {
                                    <span class="badge bg-secondary ms-2">System</span>
                                }
                            </div>
                            <span class="badge bg-light text-dark">
                                #@role.Position
                            </span>
                        </div>

                        <div class="mt-2 d-flex align-items-center gap-2">
                            <div style="width:16px;height:16px;background:@role.Color;border-radius:3px;"></div>
                            <small class="text-muted">@role.Color</small>
                        </div>

                        <div class="mt-2">
                            @RenderPermissions(role)
                        </div>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            @RenderActions((role, canManage))
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_isEditing)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_editModel.IsReadOnly ? "View Role Details" : (_editModel.Id is null ? "Create Role" : "Edit Role"))
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => _isEditing = false"></button>
                </div>
                <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@_errorMessage</div>
                        </div>
                    }

                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Role Name</label>
                                    <input class="form-control" @bind="_editModel.Name" disabled="@(!_editModel.CanEditMetadata)" placeholder="Enter role name..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Badge Color</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" class="form-control form-control-color flex-shrink-0" @bind="_editModel.Color" disabled="@(!_editModel.CanEditMetadata)" />
                                        <input type="text" class="form-control font-monospace text-uppercase" @bind="_editModel.Color" disabled="@(!_editModel.CanEditMetadata)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-uppercase tracking-wide text-muted small">Permissions Configuration</h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                            @_modelPermissions.Count Selected
                        </span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var categoryGroup in Permissions.AllWithInfo.GroupBy(p => p.Category))
                        {
                            var categoryPerms = categoryGroup.ToList();
                            var categoryPermNames = categoryPerms.Select(p => p.Name).ToList();
                            var assignedCount = categoryPermNames.Count(p => _modelPermissions.Contains(p));
                            var isAllSelected = assignedCount == categoryPermNames.Count;

                            <div class="card border shadow-sm overflow-hidden mb-3">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-semibold text-dark">@categoryGroup.Key</span>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small">
                                            @assignedCount / @categoryPermNames.Count
                                        </span>
                                    </div>
                                    @if (!_editModel.IsReadOnly)
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 fw-medium" @onclick="() => ToggleCategoryPermissions(categoryPermNames, !isAllSelected)">
                                            @(isAllSelected ? "Deselect All" : "Select All")
                                        </button>
                                    }
                                </div>

                                <div class="permission-grid">
                                    @foreach (var perm in categoryGroup)
                                    {
                                        var isAssigned = _modelPermissions.Contains(perm.Name);

                                        <div class="permission-tile @(isAssigned ? "selected" : "") @(_editModel.IsReadOnly ? "readonly" : "")" @onclick="() => TogglePermission(perm.Name, !isAssigned)">

                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <span class="permission-title">@perm.Name</span>

                                                <div class="permission-indicator">
                                                    @if (isAssigned)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-primary"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle text-tertiary"></i>
                                                    }
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(perm.Description))
                                            {
                                                <span class="permission-desc mt-1">
                                                    @perm.Description
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" @onclick="() => _isEditing = false">Close</button>
                    @if (!_editModel.IsReadOnly)
                    {
                        <button class="btn btn-primary" @onclick="SaveRole">Save Changes</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm && _roleToDelete is not null)
{
    <DeleteConfirmModal Visible="true" Message="Are you sure you want to delete" ItemName="@_roleToDelete.Name" OnCancel="CloseDeleteConfirm" OnConfirm="DeleteConfirmed" />
}

@code {
    private List<RoleDto>? _roles;
    private int _userMinPosition = 9999;

    private bool _isEditing = false;
    private RoleEditModel _editModel = new();
    private HashSet<string> _modelPermissions = new();

    private bool _showDeleteConfirm = false;
    private RoleDto? _roleToDelete;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<GetRolesResponse>("/api/roles");
            if (response is not null)
            {
                _roles = response.Roles;
                _userMinPosition = response.UserMinPosition;
            }
        }
        catch (Exception exception)
        {
            _errorMessage = "Failed to load roles.";
            Console.WriteLine(exception);
        }
    }

    private void PrepareCreate()
    {
        _editModel = new RoleEditModel
        {
            Color = "#99AAB5",
            CanEditMetadata = true,
            IsReadOnly = false
        };
        _modelPermissions.Clear();
        _isEditing = true;
    }

    private void EditRole(RoleDto role)
    {
        _errorMessage = null;

        var isDefaultRole = role.Name == RoleConstants.Default;
        var canEditPermissions = role.Position > _userMinPosition && (!role.IsBuiltIn || isDefaultRole);
        var canEditMetadata = !role.IsBuiltIn;

        _editModel = new RoleEditModel
        {
            Id = role.Id,
            Name = role.Name,
            Color = role.Color,
            IsReadOnly = !canEditPermissions,
            CanEditMetadata = canEditMetadata
        };

        _modelPermissions = role.Permissions.ToHashSet();
        _isEditing = true;
    }

    private async Task SaveRole()
    {
        _errorMessage = null;
        HttpResponseMessage? response = null;

        try
        {
            if (_editModel.Id is null)
            {
                var command = new CreateRoleCommand(
                    string.IsNullOrWhiteSpace(_editModel.Name) ? "new-role" : _editModel.Name.Trim(),
                    _editModel.Color,
                    _modelPermissions.ToList()
                );
                response = await Http.PostAsJsonAsync("/api/roles", command);
            }
            else
            {
                var command = new UpdateRoleCommand(
                    _editModel.Id.Value,
                    _editModel.Name.Trim(),
                    _editModel.Color,
                    _modelPermissions.ToList()
                );
                response = await Http.PutAsJsonAsync("/api/roles", command);
            }

            if (response.IsSuccessStatusCode)
            {
                _isEditing = false;
                await LoadData();
            }
            else
            {
                _errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception exception)
        {
            _errorMessage = "An error occurred while saving the role.";
            Console.WriteLine(exception);
        }
        finally
        {
            response?.Dispose();
        }
    }

    private async Task MoveUp(RoleDto role)
    {
        if (_roles is null || role.Position <= 0 || role.Position <= _userMinPosition + 1 || role.IsBuiltIn)
        {
            return;
        }

        var neighbor = _roles.First(item => item.Position == role.Position - 1);
        await SwapPositions(role, neighbor);
    }

    private async Task MoveDown(RoleDto role)
    {
        if (_roles is null || role.Position >= _roles.Count - 2 || role.Position <= _userMinPosition || role.IsBuiltIn)
        {
            return;
        }

        var neighbor = _roles.First(item => item.Position == role.Position + 1);
        await SwapPositions(role, neighbor);
    }

    private async Task SwapPositions(RoleDto roleA, RoleDto roleB)
    {
        var command = new SwapRolesCommand(roleA.Id, roleB.Id);
        using var response = await Http.PostAsJsonAsync("/api/roles/swap", command);

        if (response.IsSuccessStatusCode)
        {
            await LoadData();
        }
    }

    private void ConfirmDelete(RoleDto role)
    {
        _roleToDelete = role;
        _showDeleteConfirm = true;
    }

    private void CloseDeleteConfirm()
    {
        _showDeleteConfirm = false;
        _roleToDelete = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_roleToDelete is not null)
        {
            await DeleteRole(_roleToDelete);
        }

        CloseDeleteConfirm();
    }

    private async Task DeleteRole(RoleDto role)
    {
        if (role.Position <= _userMinPosition || role.IsBuiltIn)
        {
            return;
        }

        using var response = await Http.DeleteAsync($"/api/roles/{role.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
        }
    }

    private void TogglePermission(string perm, object? checkedValue)
    {
        if (_editModel.IsReadOnly)
        {
            return;
        }

        if (checkedValue is bool b && b)
        {
            _modelPermissions.Add(perm);
        }
        else
        {
            _modelPermissions.Remove(perm);
        }
    }

    private void ToggleCategoryPermissions(IEnumerable<string> permissionNames, bool selectAll)
    {
        if (_editModel.IsReadOnly)
        {
            return;
        }

        foreach (var name in permissionNames)
        {
            if (selectAll)
            {
                _modelPermissions.Add(name);
            }
            else
            {
                _modelPermissions.Remove(name);
            }
        }
    }

    RenderFragment<RoleDto> RenderPermissions => role => __builder =>
    {
        @if (role.Permissions.Any())
        {
            <div class="d-flex flex-wrap gap-1 align-items-center">
                @foreach (var p in role.Permissions.Take(3))
                {
                    <span class="badge badge-subtle border text-dark fw-normal">@p</span>
                }
                @if (role.Permissions.Count > 3)
                {
                    <span class="badge bg-secondary-subtle text-secondary border">+@(role.Permissions.Count - 3) more</span>
                }
            </div>
        }
        else
        {
            <span class="text-muted small"><em>No permissions</em></span>
        }
    };

    RenderFragment<(RoleDto, bool)> RenderActions => item => __builder =>
    {
        var (role, canManage) = item;

        <button class="btn btn-sm @(canManage ? "btn-outline-primary" : "btn-outline-secondary")" @onclick="() => EditRole(role)">
            <i class="bi @(canManage ? "bi-pencil" : "bi-eye")"></i>
            @(canManage ? "Edit" : "View")
        </button>

        @if (canManage && !role.IsBuiltIn)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(role)">Delete</button>
            if (role.Position > 0 && role.Position > _userMinPosition + 1)
            {
                <button class="btn btn-sm btn-light" @onclick="() => MoveUp(role)">▲</button>
            }
            if (_roles is not null && role.Position < _roles.Count - 2)
            {
                <button class="btn btn-sm btn-light" @onclick="() => MoveDown(role)">▼</button>
            }
        }
    };

    public class RoleEditModel
    {
        public long? Id { get; set; }

        public string Name { get; set; } = "";

        public string Color { get; set; } = "#99AAB5";

        public bool IsReadOnly { get; set; }

        public bool CanEditMetadata { get; set; }
    }
}