@inject NavigationManager NavigationManager
@implements IDisposable
@using System.Web

<div class="input-group @Class" style="@Style">
    <span class="input-group-text bg-white">
        <i class="@SearchIconClass"></i>
    </span>
    <input @ref="_inputElement" type="text" class="form-control" placeholder="@Placeholder" value="@Value" @onchange="HandleChange" />

    @if (!string.IsNullOrEmpty(Value))
    {
        <button class="btn btn-outline-secondary" type="button" @onclick="ClearAsync">
            <i class="@ClearIconClass"></i>
        </button>
    }
</div>

@code {
    private ElementReference _inputElement;

    [Parameter] public string? QueryStringKey { get; set; }
    [Parameter] public bool AutoFocus { get; set; } = false;

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    [Parameter] public string Placeholder { get => $"Search by {field}..."; set => field = value; }
    [Parameter] public string Style { get; set; } = "max-width: 400px;";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string SearchIconClass { get; set; } = "bi bi-search";
    [Parameter] public string ClearIconClass { get; set; } = "bi bi-x-lg";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(QueryStringKey))
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = HttpUtility.ParseQueryString(uri.Query);
            var urlValue = query.Get(QueryStringKey);

            if (urlValue != null)
            {
                Value = urlValue;
            }

            NavigationManager.LocationChanged += OnLocationChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoFocus)
        {
            await FocusAsync();
        }
    }

    public ValueTask FocusAsync()
        => _inputElement.FocusAsync();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!string.IsNullOrEmpty(QueryStringKey))
        {
            var uri = NavigationManager.ToAbsoluteUri(e.Location);
            var query = HttpUtility.ParseQueryString(uri.Query);
            var urlValue = query.Get(QueryStringKey) ?? string.Empty;

            if (Value != urlValue)
            {
                Value = urlValue;
                StateHasChanged();

                InvokeAsync(() => ValueChanged.InvokeAsync(Value));
                InvokeAsync(() => OnSearch.InvokeAsync(Value));
            }
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;

        if (!string.IsNullOrEmpty(QueryStringKey))
        {
            var uri = NavigationManager.GetUriWithQueryParameter(QueryStringKey, string.IsNullOrEmpty(Value) ? null : Value);
            if (NavigationManager.Uri != uri)
            {
                NavigationManager.NavigateTo(uri);
            }
        }

        await ValueChanged.InvokeAsync(Value);
        await OnSearch.InvokeAsync(Value);
    }

    private async Task ClearAsync()
    {
        Value = string.Empty;

        if (!string.IsNullOrEmpty(QueryStringKey))
        {
            var uri = NavigationManager.GetUriWithQueryParameter(QueryStringKey, (string?)null);
            if (NavigationManager.Uri != uri)
            {
                NavigationManager.NavigateTo(uri);
            }
        }

        await ValueChanged.InvokeAsync(Value);
        await OnSearch.InvokeAsync(Value);
        await OnClear.InvokeAsync();
    }
}