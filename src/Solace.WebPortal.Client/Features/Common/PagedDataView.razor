@using Solace.WebPortal.Common.Features.Common
@typeparam TData
@inject NavigationManager NavigationManager
@implements IDisposable
@using System.Web

@if (ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>@ErrorMessage
        <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
    </div>
}

@if (IsLoading && ErrorMessage is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (Data is not null && !IsLoading)
{
    @if (MatchingItems is 0)
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle fs-4 mb-2"></i>
            <span>No items found.</span>
        </div>
    }
    else
    {
        @ChildContent(Data)
    }

    @if (TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Query.Page == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePageAsync(1)" aria-label="First">
                        <span aria-hidden="true">&laquo;</span>
                    </button>
                </li>
                <li class="page-item @(Query.Page == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePageAsync(Query.Page - 1)" aria-label="Previous">
                        <span aria-hidden="true">&lsaquo;</span>
                    </button>
                </li>
                <li class="page-item disabled d-none d-sm-block">
                    <span class="page-link">Page @Query.Page of @TotalPages</span>
                </li>
                <li class="page-item @(Query.Page == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePageAsync(Query.Page + 1)" aria-label="Next">
                        <span aria-hidden="true">&rsaquo;</span>
                    </button>
                </li>
                <li class="page-item @(Query.Page == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePageAsync(TotalPages)" aria-label="Last">
                        <span aria-hidden="true">&raquo;</span>
                    </button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    [Parameter] public string? PageQueryStringKey { get; set; }
    [Parameter] public string? SearchQueryStringKey { get; set; }

    [Parameter, EditorRequired]
    public Func<PagedSearchQuery, Task<PagedResult<TData>?>> Provider { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TData> ChildContent { get; set; } = default!;

    [Parameter]
    public int DefaultPageSize { get; set; } = 10;

    [Parameter]
    public EventCallback<PagedResult<TData>> OnDataLoaded { get; set; }

    public PagedSearchQuery Query { get; private set; } = new(null, 1, 10);
    public bool IsLoading { get; private set; } = true;
    public string? ErrorMessage { get; set; }
    public TData? Data { get; private set; }

    public int? TotalItems { get; private set; }
    public int? MatchingItems { get; private set; }
    public int TotalPages { get; private set; } = 1;

    protected override void OnInitialized()
    {
        int initialPage = 1;
        string? initialSearch = null;

        if (!string.IsNullOrEmpty(PageQueryStringKey) || !string.IsNullOrEmpty(SearchQueryStringKey))
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = HttpUtility.ParseQueryString(uri.Query);

            if (!string.IsNullOrEmpty(PageQueryStringKey) && int.TryParse(query.Get(PageQueryStringKey), out var p))
            {
                initialPage = int.Max(1, p);
            }
            if (!string.IsNullOrEmpty(SearchQueryStringKey))
            {
                initialSearch = query.Get(SearchQueryStringKey);
            }

            NavigationManager.LocationChanged += OnLocationChanged;
        }

        Query = new PagedSearchQuery(initialSearch, initialPage, DefaultPageSize);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (string.IsNullOrEmpty(PageQueryStringKey) && string.IsNullOrEmpty(SearchQueryStringKey)) return;

        var uri = NavigationManager.ToAbsoluteUri(e.Location);
        var query = HttpUtility.ParseQueryString(uri.Query);

        bool changed = false;
        int newPage = Query.Page;
        string? newSearch = Query.SearchTerm;

        if (!string.IsNullOrEmpty(PageQueryStringKey))
        {
            var pStr = query.Get(PageQueryStringKey);
            int p = int.TryParse(pStr, out var parsed) ? parsed : 1;
            p = int.Max(1, p);

            if (p != Query.Page)
            {
                newPage = p;
                changed = true;
            }
        }

        if (!string.IsNullOrEmpty(SearchQueryStringKey))
        {
            var s = query.Get(SearchQueryStringKey);
            if (s != Query.SearchTerm)
            {
                newSearch = s;
                changed = true;
            }
        }

        if (changed)
        {
            Query = Query with { Page = newPage, SearchTerm = newSearch };
            InvokeAsync(LoadDataAsync);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    public async Task SearchAsync(string? searchTerm)
    {
        if (!string.IsNullOrEmpty(SearchQueryStringKey))
        {
            var dict = new Dictionary<string, object?>
            {
                [SearchQueryStringKey] = string.IsNullOrEmpty(searchTerm) ? null : searchTerm
            };

            if (!string.IsNullOrEmpty(PageQueryStringKey))
            {
                dict[PageQueryStringKey] = null;
            }

            var uri = NavigationManager.GetUriWithQueryParameters(dict);

            if (NavigationManager.Uri != uri)
            {
                NavigationManager.NavigateTo(uri);
                return;
            }
        }

        Query = Query with { SearchTerm = searchTerm, Page = 1 };
        await LoadDataAsync();
    }

    public async Task ReloadCurrentPageAsync()
    {
        await LoadDataAsync();
    }

    private async Task ChangePageAsync(int newPage)
    {
        var clampedPage = int.Clamp(newPage, 1, int.Max(1, TotalPages));
        if (clampedPage != Query.Page)
        {
            if (!string.IsNullOrEmpty(PageQueryStringKey))
            {
                var uri = NavigationManager.GetUriWithQueryParameter(PageQueryStringKey, clampedPage <= 1 ? null : (int?)clampedPage);
                if (NavigationManager.Uri != uri)
                {
                    NavigationManager.NavigateTo(uri);
                    return;
                }
            }

            Query = Query with { Page = clampedPage };
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await Provider(Query);

            if (result is not null)
            {
                Data = result.Data;

                if (result is PagedSearchResult<TData> searchResult)
                {
                    TotalItems = searchResult.TotalCount;
                    MatchingItems = searchResult.MatchingCount;
                }
                else
                {
                    TotalItems = result.TotalCount;
                    MatchingItems = result.TotalCount;
                }

                Console.WriteLine(TotalItems);
                Console.WriteLine(MatchingItems); StateHasChanged();

                TotalPages = int.Max(1, (int)double.Ceiling((double)MatchingItems / Query.PageSize));

                if (Query.Page > TotalPages)
                {
                    Query = Query with { Page = TotalPages };
                    var clampedResult = await Provider(Query);
                    if (clampedResult is not null)
                    {
                        Data = clampedResult.Data;
                    }
                }

                if (OnDataLoaded.HasDelegate)
                {
                    await OnDataLoaded.InvokeAsync(result);
                }
            }
        }
        catch
        {
            ErrorMessage = "An error occurred while loading data.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}