@page "/Store/Tabs/Create"
@page "/Store/Tabs/Edit/{TabIndex:int}"
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Client.Features.Store.Models
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Store
@using Solace.WebPortal.Common.Features.Catalog
@using System.Diagnostics
@using System.Security.Claims
@attribute [Authorize(Policy = Permissions.ViewStore)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager
@inject IServiceProvider ServiceProvider

<PageTitle>Store Tab - Solace</PageTitle>

@if (!DataLoaded)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>
            <h3 class="mb-0">@(TabIndex is null ? "Create New Tab" : HasPermission(Permissions.EditStore) ? $"Edit Tab {TabIndex}" : $"View Tab {TabIndex}")</h3>
        </div>

        <button type="button" class="btn @(IsPreviewMode ? "btn-primary" : "btn-outline-primary")" @onclick="TogglePreview">
            <i class="bi @(IsPreviewMode ? "bi-pencil-square" : "bi-eye") me-1"></i>
            @(IsPreviewMode ? "Edit Mode" : "Preview Mode")
        </button>
    </div>

    @if (IsPreviewMode)
    {
        <div class="preview-container bg-light p-4 border">
            @if (Model.ScreenLayoutQueries.Count is 0)
            {
                <p class="text-muted mb-0"><em>No layout queries to preview.</em></p>
            }

            @foreach (var layoutQuery in Model.ScreenLayoutQueries)
            {
                <div class="mb-4">
                    @if (layoutQuery.ColumnType is ColumnType.Grid)
                    {
                        <div class="layout-grid">
                            @foreach (var query in layoutQuery.Queries)
                            {
                                @foreach (var productId in query.ProductIds)
                                {
                                    <div class="preview-box grid-item shadow-sm bg-white">
                                        @RenderPreviewCard(productId)
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (layoutQuery.ColumnType is ColumnType.Square)
                    {
                        <div class="layout-square">
                            @foreach (var query in layoutQuery.Queries)
                            {
                                @foreach (var productId in query.ProductIds)
                                {
                                    <div class="preview-box square shadow-sm bg-white">
                                        @RenderPreviewCard(productId)
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (layoutQuery.ColumnType is ColumnType.Rectangle)
                    {
                        <div class="layout-rectangle">
                            @foreach (var query in layoutQuery.Queries)
                            {
                                @foreach (var productId in query.ProductIds)
                                {
                                    <div class="preview-box rectangle shadow-sm bg-white">
                                        @RenderPreviewCard(productId)
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="card mb-3 shadow-sm">
                <div class="card-body py-2 px-3 bg-light">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1">Tab ID</label>
                            <InputText @bind-Value="Model.TabId" class="form-control form-control-sm" readonly="@(!HasPermission(Permissions.EditStore))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1">Tab Title</label>
                            <InputText @bind-Value="Model.TabTitle" class="form-control form-control-sm" readonly="@(!HasPermission(Permissions.EditStore))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold mb-1">Tab Icon</label>
                            <InputText @bind-Value="Model.TabIcon" class="form-control form-control-sm" placeholder="textures/ui/icons/..." readonly="@(!HasPermission(Permissions.EditStore))" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Layout Columns</h5>
                @if (HasPermission(Permissions.EditStore))
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLayout">
                        <i class="bi bi-plus-lg me-1"></i> Add Layout Column
                    </button>
                }
            </div>

            @foreach (var (layout, layoutIndex) in Model.ScreenLayoutQueries.Select((l, i) => (l, i)))
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold small text-muted me-2">#@(layoutIndex + 1)</span>
                            <label class="form-label small fw-bold mb-0 me-1">Column Type:</label>
                            <InputSelect @bind-Value="layout.ColumnType" class="form-select form-select-sm w-auto" disabled="@(!HasPermission(Permissions.EditStore))">
                                <option value="@ColumnType.Rectangle">Rectangle</option>
                                <option value="@ColumnType.Square">Square</option>
                                <option value="@ColumnType.Grid">Grid</option>
                            </InputSelect>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            @if (HasPermission(Permissions.EditStore))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => layout.Queries.Add(new QueryViewModel())">
                                    + Add Query
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Model.ScreenLayoutQueries.Remove(layout)">
                                    Remove Layout
                                </button>
                            }
                        </div>
                    </div>

                    <div class="card-body p-2">
                        @if (layout.Queries.Count is 0)
                        {
                            <p class="text-muted small mb-0 p-2"><em>No queries added yet. Click "+ Add Query" above.</em></p>
                        }

                        @foreach (var (query, qIndex) in layout.Queries.Select((q, i) => (q, i)))
                        {
                            <div class="border rounded p-2 mb-2 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                                    <span class="fw-bold small text-primary">Query @(qIndex + 1)</span>
                                    @if (HasPermission(Permissions.EditStore))
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="() => layout.Queries.Remove(query)">
                                            Remove Query
                                        </button>
                                    }
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    @if (AvailableItems is null)
                                    {
                                        <span class="small text-muted"><em>Loading items...</em></span>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < query.ProductIds.Count; i++)
                                        {
                                            var index = i;
                                            var currentProductId = query.ProductIds[index];
                                            var item = AvailableItems.FirstOrDefault(it => it.Id == currentProductId);

                                            <div class="input-group input-group-sm flex-grow-1" style="min-width: 260px; max-width: 100%;">
                                                <button type="button" class="form-control text-start bg-white text-truncate" disabled="@(!HasPermission(Permissions.EditStore))" @onclick="() => OpenItemPicker(layout, query, index)">
                                                    @if (item is not null)
                                                    {
                                                        <span>@item.Title <span class="text-muted">(@item.ItemDataType)</span></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Select an item...</span>
                                                    }
                                                </button>
                                                @if (HasPermission(Permissions.EditStore))
                                                {
                                                    <button type="button" class="btn btn-outline-danger" @onclick="() => query.ProductIds.RemoveAt(index)">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (HasPermission(Permissions.EditStore))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" disabled="@(AvailableItems.Count(i => !query.ProductIds.Contains(i.Id)) == 0)" @onclick="() => OpenItemPicker(layout, query, null)">
                                                <i class="bi bi-plus me-1"></i>Product
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (HasPermission(Permissions.EditStore))
            {
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save Tab</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                </div>
            }
        </EditForm>
    }
}

@if (IsItemPickerOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title fs-6">Select Item</h5>
                    <button type="button" class="btn-close" @onclick="CloseItemPicker"></button>
                </div>
                <div class="modal-body">
                    <Solace.WebPortal.Client.Features.Common.SearchBar @bind-Value="SearchTerm" Class="mb-3" AutoFocus="true" />

                    <div class="list-group">
                        @if (FilteredItems.Count is 0)
                        {
                            <div class="text-center text-muted py-3">No available items match your search.</div>
                        }
                        else
                        {
                            @foreach (var item in FilteredItems)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="() => SelectItem(item.Id)">
                                    <div>
                                        <div class="fw-bold">@item.Title</div>
                                        <small class="text-muted">Type: @item.ItemDataType</small>
                                    </div>
                                    <i class="bi bi-plus text-muted"></i>
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseItemPicker">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? TabIndex { get; set; }
    private ClaimsPrincipal? _user;
    private TabViewModel Model { get; set; } = new();
    private bool DataLoaded;

    private List<ItemViewModel>? AvailableItems;
    private bool IsPreviewMode = false;
    private Catalog.CatalogCacheService? CatalogService { get; set; }
    private Catalog.CatalogCacheService.SyncAccessor? Catalog;

    private bool IsItemPickerOpen = false;
    private ScreenLayoutQueryViewModel? ActiveLayout;
    private QueryViewModel? ActiveQuery;
    private int? ActiveProductIndex;
    private string SearchTerm = string.Empty;

    private List<ItemViewModel> FilteredItems
    {
        get
        {
            if (AvailableItems is null || ActiveLayout is null || ActiveQuery is null)
            {
                return [];
            }

            var layoutProductIds = ActiveLayout.Queries
                .SelectMany(q => q.ProductIds)
                .ToHashSet();

            var currentSelectedId = ActiveProductIndex.HasValue && ActiveProductIndex.Value < ActiveQuery.ProductIds.Count
                ? ActiveQuery.ProductIds[ActiveProductIndex.Value]
                : (Guid?)null;

            return AvailableItems
                .Where(item => !layoutProductIds.Contains(item.Id) || item.Id == currentSelectedId)
                .Where(item => string.IsNullOrWhiteSpace(SearchTerm) ||
                    item.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    item.ItemDataType.ToString().Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthenticationStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> task)
    {
        var authState = await task;
        _user = authState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CatalogService = ServiceProvider.GetRequiredService<Catalog.CatalogCacheService>();
            Catalog = await CatalogService.GetSyncAccessorAsync();

            AvailableItems = (await Http.GetFromJsonAsync<List<Solace.WebPortal.Common.Features.Store.ItemDto>>("api/store/items"))!
                .Select(ItemViewModel.FromDto)
                .OrderBy(item => item.ItemDataType)
                .ThenBy(item => item.Title)
                .ToList();

            if (TabIndex is not null)
            {
                Model = TabViewModel.FromDto((await Http.GetFromJsonAsync<TabDto>($"api/store/tabs/{TabIndex}"))!);
            }

            DataLoaded = true;

            StateHasChanged();
        }
    }

    private void TogglePreview()
    {
        IsPreviewMode = !IsPreviewMode;
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/Store");
    }

    private async Task OpenItemPicker(ScreenLayoutQueryViewModel layout, QueryViewModel query, int? index)
    {
        ActiveLayout = layout;
        ActiveQuery = query;
        ActiveProductIndex = index;
        SearchTerm = string.Empty;
        IsItemPickerOpen = true;
    }

    private void CloseItemPicker()
    {
        IsItemPickerOpen = false;
        ActiveLayout = null;
        ActiveQuery = null;
        ActiveProductIndex = null;
        SearchTerm = string.Empty;
    }

    private void SelectItem(Guid productId)
    {
        if (ActiveQuery is null) return;

        if (ActiveProductIndex.HasValue)
        {
            ActiveQuery.ProductIds[ActiveProductIndex.Value] = productId;
        }
        else
        {
            ActiveQuery.ProductIds.Add(productId);
        }

        CloseItemPicker();
    }

    private RenderFragment RenderPreviewCard(Guid productId) => __builder =>
    {
        var storeItem = AvailableItems?.FirstOrDefault(i => i.Id == productId);
        var rarityColor = GetRarityColor(storeItem);
        var title = storeItem?.Title ?? "Unknown Item";
        var price = GetPrice(storeItem);

        <div class="preview-content-body" style="border-color: @rarityColor;">
            <div class="preview-title" title="@title">
                @title.ToUpper()
            </div>
            <div class="preview-media">
                @RenderPreviewMedia(storeItem)
            </div>
        </div>
        <div class="preview-price-bar">
            <i class="bi bi-gem"></i>
            <span>@(price is 0 ? "FREE" : price.ToString())</span>
        </div>
    };

    private RenderFragment RenderPreviewMedia(ItemViewModel? storeItem) => __builder =>
    {
        if (storeItem is not null)
        {
            if (storeItem.ItemDataType is ItemDataType.Buildplate)
            {
                <Solace.WebPortal.Client.Features.Buildplates.BuildplatePreview BuildplateId="@storeItem.Buildplate.BuildplateId" IsTemplate="true" />
                return;
            }

            if (Catalog is not null && Catalog.Value.TryGetItem(storeItem.InventoryItem.ItemId, out var catItem))
            {
                <img src="/static/genoa-textures/ui/items/@(GetTextureName(catItem)).png" onerror="this.onerror=null; this.src='/static/missing_texture.png';" alt="@catItem.Name" title="@catItem.Name" />
                return;
            }
        }

        <img src="/static/missing_texture.png" alt="Missing Item" title="Item not found in catalog" />
    };

    private static string GetRarityColor(ItemViewModel? storeItem)
    {
        if (storeItem is null)
        {
            return "#808080";
        }

        var rarity = storeItem.ItemDataType switch
        {
            ItemDataType.Buildplate => storeItem.Buildplate.Rarity,
            ItemDataType.InventoryItem => storeItem.InventoryItem.Rarity,
            _ => throw new UnreachableException(),
        };

        return rarity switch
        {
            Rarity.Uncommon => "#28a745",
            Rarity.Rare => "#007bff",
            Rarity.Epic => "#6f42c1",
            Rarity.Legendary => "#ffc107",
            Rarity.Common or Rarity.Uncommon or _ => "#808080",
        };
    }

    private static object GetPrice(ItemViewModel? storeItem)
    {
        if (storeItem is null)
        {
            return 0;
        }

        if (storeItem.ItemDataType is ItemDataType.Buildplate)
        {
            return storeItem.Buildplate.Cost;
        }

        if (storeItem.InventoryItem is not null)
        {
            return storeItem.InventoryItem.Cost;
        }

        return 0;
    }

    private static string GetTextureName(Solace.WebPortal.Common.Features.Catalog.ItemDto item)
    {
        if (item.Category is ItemDtoCategory.BoostAdventureXP or ItemDtoCategory.BoostCrafting or
            ItemDtoCategory.BoostDefense or ItemDtoCategory.BoostEating or ItemDtoCategory.BoostHealth or
            ItemDtoCategory.BoostHoarding or ItemDtoCategory.BoostItemXP or ItemDtoCategory.BoostMiningSpeed or
            ItemDtoCategory.BoostRetention or ItemDtoCategory.BoostSmelting or ItemDtoCategory.BoostStrength or
            ItemDtoCategory.BoostTappableRadius)
        {
            return item.Id.ToString();
        }

        return item.Name + "_" + item.Aux;
    }

    private void AddLayout()
    {
        Model.ScreenLayoutQueries.Add(new ScreenLayoutQueryViewModel());
    }

    private async Task HandleSubmit()
    {
        HttpResponseMessage response;
        if (TabIndex is not null)
        {
            response = await Http.PutAsJsonAsync($"api/store/tabs/{TabIndex}", Model.ToDto());
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/store/tabs", Model.ToDto());
        }

        if (response.IsSuccessStatusCode)
        {
            NavManager.NavigateTo("/Store");
        }
    }

    private bool HasPermission(string permission)
        => _user?.HasPermission(permission) ?? false;
}