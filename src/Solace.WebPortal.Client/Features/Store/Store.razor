@page "/Store"
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Store
@attribute [Authorize(Policy = Permissions.ViewStore)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Store - Solace</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Store</h2>
        <div class="d-flex gap-2 align-items-center">
            @if (hasUpdateAvailable)
            {
                if (HasPermission(Permissions.EditStore))
                {
                    <button class="btn btn-success animate-pulse" @onclick="OpenUpdateModal">
                        <i class="bi bi-arrow-up-circle me-1"></i> Update to v@(latestVersion)
                    </button>
                }
                else
                {
                    <button class="btn btn-success animate-pulse" disabled>
                        <i class="bi bi-arrow-up-circle me-1"></i> An update to v@(latestVersion) is available
                    </button>
                }
            }

            @if (HasPermission(Permissions.EditStore))
            {
                <button class="btn btn-outline-warning" @onclick="OpenResetModal">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Data
                </button>
                <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/Store/Tabs/Create")'>
                    + Create Tab
                </button>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/Store/Items/Create")'>
                    + Create Item
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading store data...</span>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else
    {
        @if (tabs == null || !tabs.Any())
        {
            <div class="alert alert-info">No tabs available.</div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @for (int i = 0; i < tabs.Count; i++)
                {
                    var tabIndex = i + 1;
                    var tab = tabs[i];
                    var tabItems = items?.Where(x => tab.Items is not null && tab.Items.Contains(x.Id)).ToList() ?? new List<ItemSummaryDto>();
                    var isExpanded = expandedTabIndices.Contains(tabIndex);

                    <div class="card shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => ToggleTab(tabIndex)">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                <span class="badge bg-secondary">#@tabIndex</span>
                                <h5 class="mb-0">@tab.TabId</h5>
                            </div>
                            <div class="d-flex gap-2" @onclick:stopPropagation="true">
                                <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo($"/Store/Tabs/Edit/{tabIndex}")'>
                                    @(HasPermission(Permissions.EditStore) ? "Edit" : "View")
                                </button>
                                @if (HasPermission(Permissions.EditStore))
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick='() => OpenDeleteTabModal(tab, tabIndex)'>
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <ul class="list-group list-group-flush">
                                @if (!tabItems.Any())
                                {
                                    <li class="list-group-item text-muted fst-italic ps-4">
                                        No items in this tab.
                                    </li>
                                }
                                else
                                {
                                    @foreach (var item in tabItems)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center ps-4 @(item.Purchasable ? "" : "opacity-50")" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/Store/Items/Edit/{item.Id}")'>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <strong class="@(item.Purchasable ? "" : "text-decoration-line-through")">
                                                        @item.Title
                                                    </strong>
                                                    <span class="badge bg-info">@item.ItemDataType</span>
                                                    @if (!item.Purchasable)
                                                    {
                                                        <small class="text-muted fst-italic">(Not Purchasable)</small>
                                                    }
                                                </div>
                                                @if (item.StartDate > DateTimeOffset.UtcNow)
                                                {
                                                    <small class="text-muted d-block">
                                                        @GetRelativeTimeString(item.StartDate)
                                                    </small>
                                                }
                                            </div>
                                            @if (HasPermission(Permissions.EditStore))
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick='() => OpenDeleteItemModal(item)'>
                                                    Delete
                                                </button>
                                            }
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    </div>
                }

                @{
                    var unassignedItems = items?.Where(x => tabs.All(t => t.Items == null || !t.Items.Contains(x.Id))).ToList();
                }
                @if (unassignedItems is not null && unassignedItems.Any())
                {
                    <div class="card shadow-sm border-warning">
                        <div class="card-header bg-warning-subtle">
                            <h5 class="mb-0">Unassigned Items</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in unassignedItems)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center ps-4 @(item.Purchasable ? "" : "opacity-50")" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/Store/Items/Edit/{item.Id}")'>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <strong class="@(item.Purchasable ? "" : "text-decoration-line-through")">
                                                @item.Title
                                            </strong>
                                            <span class="badge bg-info">@item.ItemDataType</span>
                                            @if (!item.Purchasable)
                                            {
                                                <small class="text-muted fst-italic">(Not Purchasable)</small>
                                            }
                                        </div>
                                        @if (item.StartDate > DateTimeOffset.UtcNow)
                                        {
                                            <small class="text-muted d-block">
                                                @GetRelativeTimeString(item.StartDate)
                                            </small>
                                        }
                                    </div>
                                    @if (HasPermission(Permissions.EditStore))
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick='() => OpenDeleteItemModal(item)'>
                                            Delete
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</div>

<Solace.WebPortal.Client.Features.Common.DeleteConfirmModal Visible="showDeleteModal" IsBusy="isDeleting" ItemName="@deleteTargetName" ErrorMessage="@deleteErrorMessage" OnCancel="CloseDeleteModal" OnConfirm="ConfirmDelete" />

@if (showResetModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title text-warning-emphasis">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Reset Store Data
                    </h5>
                    <button type="button" class="btn-close" style="filter: invert(0);" @onclick="CloseResetModal" disabled="@isResetting"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> All tabs and items will be overwritten.
                    </div>
                    <p class="mb-0">Are you sure you want to reset all store data back to default?</p>

                    @if (!string.IsNullOrEmpty(resetErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @resetErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetModal" disabled="@isResetting">Cancel</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmReset" disabled="@isResetting">
                        @if (isResetting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Confirm Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUpdateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-up-circle me-2"></i>Update Store Data (v@(latestVersion))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUpdateModal" disabled="@isUpdating"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> Default tabs and items will be overwritten.
                    </div>
                    <p class="mb-0">A store data update @(string.IsNullOrEmpty(currentVersion) ? (MarkupString)"to version" : (MarkupString)$"from version <strong>v{currentVersion}</strong> to") <strong>v@(latestVersion)</strong> is available. Do you want to apply this update now?</p>

                    @if (!string.IsNullOrEmpty(updateErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @updateErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUpdateModal" disabled="@isUpdating">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmUpdate" disabled="@isUpdating">
                        @if (isUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Apply Update
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public sealed record StoreVersionInfo(Version? CurrentVersion, Version AvailableVersion);

    private ClaimsPrincipal? _user;

    private List<TabSummaryDto>? tabs;
    private List<ItemSummaryDto>? items;
    private bool isLoading = true;
    private string? errorMessage;

    private HashSet<int> expandedTabIndices = new();

    // Delete Modal State
    private bool showDeleteModal;
    private bool isDeleting;
    private string? deleteTargetName;
    private string? deleteErrorMessage;
    private Func<Task>? pendingDeleteAction;

    private bool hasUpdateAvailable;
    private string? currentVersion;
    private string latestVersion = string.Empty;
    private bool showUpdateModal;
    private bool isUpdating;
    private string? updateErrorMessage;

    private bool showResetModal;
    private bool isResetting;
    private string? resetErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthenticationStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> task)
    {
        var authState = await task;
        _user = authState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadStoreDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadStoreDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var tabsTask = Http.GetFromJsonAsync<List<TabSummaryDto>>("api/store/tabs/summary?includeItems=true");
            var itemsTask = Http.GetFromJsonAsync<List<ItemSummaryDto>>("api/store/items/summary");
            var versionTask = Http.GetFromJsonAsync<StoreVersionInfo>("api/store/data/version");

            await Task.WhenAll(tabsTask, itemsTask, versionTask);

            tabs = await tabsTask ?? new();
            items = await itemsTask ?? new();

            var versionInfo = await versionTask;
            if (versionInfo?.AvailableVersion is not null)
            {
                currentVersion = versionInfo.CurrentVersion?.ToString();
                latestVersion = versionInfo.AvailableVersion.ToString();
                hasUpdateAvailable = versionInfo.CurrentVersion is null || versionInfo.AvailableVersion > versionInfo.CurrentVersion;
            }
            else
            {
                hasUpdateAvailable = false;
            }
        }
        catch
        {
            errorMessage = "Failed to load store summary data. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleTab(int index)
    {
        if (!expandedTabIndices.Remove(index))
        {
            expandedTabIndices.Add(index);
        }
    }

    // Reset Modal Handlers
    private void OpenResetModal()
    {
        resetErrorMessage = null;
        showResetModal = true;
    }

    private void CloseResetModal()
    {
        showResetModal = false;
        resetErrorMessage = null;
    }

    private async Task ConfirmReset()
    {
        try
        {
            isResetting = true;
            resetErrorMessage = null;

            var response = await Http.PostAsync("api/store/data/reset", null);
            if (response.IsSuccessStatusCode)
            {
                showResetModal = false;
                await LoadStoreDataAsync();
            }
            else
            {
                resetErrorMessage = "Failed to reset store data. Please try again.";
            }
        }
        catch (Exception ex)
        {
            resetErrorMessage = ex.Message;
        }
        finally
        {
            isResetting = false;
        }
    }

    // Update Modal Handlers
    private void OpenUpdateModal()
    {
        updateErrorMessage = null;
        showUpdateModal = true;
    }

    private void CloseUpdateModal()
    {
        showUpdateModal = false;
        updateErrorMessage = null;
    }

    private async Task ConfirmUpdate()
    {
        try
        {
            isUpdating = true;
            updateErrorMessage = null;

            var response = await Http.PostAsync("api/store/data/update", null);
            if (response.IsSuccessStatusCode)
            {
                showUpdateModal = false;
                await LoadStoreDataAsync();
            }
            else
            {
                updateErrorMessage = "Failed to update store data. Please try again.";
            }
        }
        catch (Exception ex)
        {
            updateErrorMessage = ex.Message;
        }
        finally
        {
            isUpdating = false;
        }
    }

    // Delete Handlers
    private void OpenDeleteTabModal(TabSummaryDto tab, int index)
    {
        deleteTargetName = $"Tab #{index} ({tab.TabId})";
        deleteErrorMessage = null;
        pendingDeleteAction = async () =>
        {
            var response = await Http.DeleteAsync($"api/store/tabs/{index}");
            if (response.IsSuccessStatusCode)
            {
                tabs?.Remove(tab);
            }
            else
            {
                throw new Exception("Failed to delete tab.");
            }
        };
        showDeleteModal = true;
    }

    private void OpenDeleteItemModal(ItemSummaryDto item)
    {
        deleteTargetName = item.Title;
        deleteErrorMessage = null;
        pendingDeleteAction = async () =>
        {
            var response = await Http.DeleteAsync($"api/store/items/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                items?.Remove(item);
            }
            else
            {
                throw new Exception("Failed to delete item.");
            }
        };
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (pendingDeleteAction is null)
        {
            return;
        }

        try
        {
            isDeleting = true;
            deleteErrorMessage = null;
            await pendingDeleteAction();
            showDeleteModal = false;
        }
        catch (Exception exception)
        {
            deleteErrorMessage = exception.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteErrorMessage = null;
        pendingDeleteAction = null;
    }

    private string GetRelativeTimeString(DateTimeOffset startDate)
    {
        var timeSpan = startDate - DateTimeOffset.UtcNow;

        if (timeSpan.TotalMinutes < 1)
        {
            return "Starts in less than a minute";
        }

        if (timeSpan.TotalHours < 1)
        {
            var minutes = (int)double.Ceiling(timeSpan.TotalMinutes);
            return $"Starts in {minutes} minute{(minutes == 1 ? "" : "s")}";
        }

        if (timeSpan.TotalDays < 1)
        {
            var hours = (int)double.Floor(timeSpan.TotalHours);
            return $"Starts in {hours} hour{(hours == 1 ? "" : "s")}";
        }

        var days = (int)double.Floor(timeSpan.TotalDays);
        return $"Starts in {days} day{(days == 1 ? "" : "s")}";
    }

    private bool HasPermission(string permission)
        => _user?.HasPermission(permission) ?? false;
}