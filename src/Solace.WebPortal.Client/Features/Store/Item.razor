@page "/Store/Items/Create"
@page "/Store/Items/Edit/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Client.Features.Common
@using Solace.WebPortal.Client.Features.Store.Models
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Common
@using Solace.WebPortal.Common.Features.Store
@using System.Security.Claims
@using CatalogItemDto = Solace.WebPortal.Common.Features.Catalog.ItemDto
@using CatalogItemDtoCategory = Solace.WebPortal.Common.Features.Catalog.ItemDtoCategory
@attribute [Authorize(Policy = Permissions.ViewStore)]
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager
@inject IServiceProvider ServiceProvider

<PageTitle>Store Item - Solace</PageTitle>

<div class="d-flex align-items-center gap-2">
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">
        <i class="bi bi-arrow-left me-1"></i> Back
    </button>
    <h3>@(Id is null ? "Create New Item" : HasPermission(Permissions.EditStore) ? $"Edit {Model.Title}" : $"View {Model.Title}")</h3>
</div>

@if (!DataLoaded)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <EditForm Model="Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label>Title</label>
            <InputText @bind-Value="Model.Title" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
        </div>

        <div class="mb-3">
            <label>Description</label>
            <InputTextArea @bind-Value="Model.Description" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
        </div>

        <div class="mb-3 border p-3 rounded bg-white">
            <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-2 fw-bold fs-5" @onclick="() => _showTranslations = !_showTranslations">
                <i class="bi @(_showTranslations ? "bi-chevron-down" : "bi-chevron-right")"></i>
                <span>Translations</span>
                @if (ActiveTranslationCodes.Any())
                {
                    <span class="badge bg-secondary ms-1" style="font-size: 0.75rem;">@ActiveTranslationCodes.Count</span>
                }
            </button>

            @if (_showTranslations)
            {
                <div class="mt-3">
                    <div class="row g-2 align-items-center mb-3">
                        @if (HasPermission(Permissions.EditStore))
                        {
                            <div class="col-sm-6 col-md-4">
                                <select class="form-select form-select-sm" @bind="_selectedLanguageToAdd">
                                    <option value="">-- Add Language --</option>
                                    @foreach (var lang in AvailableLanguages)
                                    {
                                        if (!ActiveTranslationCodes.Contains(lang.Code))
                                        {
                                            <option value="@lang.Code">@lang.DisplayName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddLanguageTranslation" disabled="@string.IsNullOrEmpty(_selectedLanguageToAdd)">
                                    <i class="bi bi-plus-lg me-1"></i> Add
                                </button>
                            </div>
                        }
                    </div>

                    @if (!ActiveTranslationCodes.Any())
                    {
                        <div class="text-muted fst-italic p-2 border rounded bg-light small">No translations added yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive border rounded bg-light p-2">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <thead>
                                    <tr class="text-muted small border-bottom">
                                        <th style="width: 25%;">Language</th>
                                        <th style="width: 35%;">Title</th>
                                        <th style="width: 35%;">Description</th>
                                        @if (HasPermission(Permissions.EditStore))
                                        {
                                            <th style="width: 5%;" class="text-center"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var langCode in ActiveTranslationCodes)
                                    {
                                        <tr>
                                            <td class="fw-semibold small">
                                                @GetLanguageDisplayName(langCode)
                                                <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">@langCode</span>
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" value="@GetTranslation(Model.TitleTranslations, langCode)" @onchange="@(e => SetTranslation(Model.TitleTranslations, langCode, e.Value?.ToString()))" placeholder="Title..." readonly="@(!HasPermission(Permissions.EditStore))" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" value="@GetTranslation(Model.DescriptionTranslations, langCode)" @onchange="@(e => SetTranslation(Model.DescriptionTranslations, langCode, e.Value?.ToString()))" placeholder="Description..." readonly="@(!HasPermission(Permissions.EditStore))" />
                                            </td>
                                            @if (HasPermission(Permissions.EditStore))
                                            {
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-sm p-1" @onclick="() => RemoveLanguageTranslation(langCode)" title="Remove Translation">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox @bind-Value="Model.Purchasable" class="form-check-input" id="purchasableCheck" disabled="@(!HasPermission(Permissions.EditStore))" />
            <label class="form-check-label" for="purchasableCheck">Purchasable</label>
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox @bind-Value="Model.Discount" class="form-check-input" id="discountCheck" disabled="@(!HasPermission(Permissions.EditStore))" />
            <label class="form-check-label" for="discountCheck">Discount</label>
        </div>

        <div class="mb-3">
            <label class="form-label" for="startDateInput">Start Date</label>
            <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Model.StartDate" class="form-control" id="startDateInput" disabled="@(!HasPermission(Permissions.EditStore))" />
        </div>

        <div class="mb-3 border p-3 rounded">
            <h4>Item Data</h4>
            <div class="mb-3">
                <label>Data Type</label>
                <InputSelect @bind-Value="Model.ItemDataType" class="form-select" disabled="@(!HasPermission(Permissions.EditStore))">
                    <option value="Buildplate">Buildplate</option>
                    <option value="InventoryItem">Inventory Item</option>
                </InputSelect>
            </div>

            @if (Model.ItemDataType is ItemDataType.Buildplate)
            {
                <div class="row mb-3">
                    <div class="col-12 mb-2">
                        <label>Target Buildplate</label>
                        <div class="input-group">
                            <InputText @bind-Value="SelectedBuildplateDisplay" class="form-control" disabled placeholder="No Buildplate Selected..." readonly="@(!HasPermission(Permissions.EditStore))" />
                            @if (HasPermission(Permissions.EditStore))
                            {
                                <button type="button" class="btn btn-secondary" @onclick="() => _showBuildplatePicker = true">
                                    <i class="bi bi-search"></i> Select
                                </button>
                            }
                            @if (Model.Buildplate.BuildplateId != Guid.Empty && HasPermission(Permissions.ViewBuildplates))
                            {
                                <a class="btn btn-outline-secondary" href="/BuildplateTemplates?q=@Model.Buildplate.BuildplateId" target="_blank">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> View
                                </a>
                            }
                        </div>
                        <ValidationMessage For="@(() => Model.Buildplate.BuildplateId)" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col"><label>Cost</label>
                        <InputNumber @bind-Value="Model.Buildplate.Cost" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
                    </div>
                    <div class="col"><label>Unlock Level</label>
                        <InputNumber @bind-Value="Model.Buildplate.UnlockLevel" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
                    </div>
                    <div class="col"><label>Rarity</label>
                        <InputSelect @bind-Value="Model.Buildplate.Rarity" class="form-select" disabled="@(!HasPermission(Permissions.EditStore))">
                            <option value="@Rarity.None">None</option>
                            <option value="@Rarity.Common">Common</option>
                            <option value="@Rarity.Uncommon">Uncommon</option>
                            <option value="@Rarity.Epic">Epic</option>
                            <option value="@Rarity.Rare">Rare</option>
                            <option value="@Rarity.Legendary">Legendary</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="Model.Buildplate.Is1Player" class="form-check-input" id="is1PlayerCheck" disabled="@(!HasPermission(Permissions.EditStore))" />
                    <label class="form-check-label" for="is1PlayerCheck">Is 1 Player</label>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block fw-bold">Tags</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @if (Model.Buildplate.Tags.Any())
                        {
                            @foreach (var tag in Model.Buildplate.Tags)
                            {
                                <span class="badge bg-secondary d-inline-flex align-items-center gap-1 p-2 fs-6">
                                    @tag
                                    @if (HasPermission(Permissions.EditStore))
                                    {
                                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" @onclick="() => RemoveTag(tag)" title="Remove Tag"></button>
                                    }
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted fst-italic small">No tags added.</span>
                        }
                    </div>

                    @if (HasPermission(Permissions.EditStore))
                    {
                        <div class="input-group input-group-sm" style="max-width: 320px;">
                            <input type="text" class="form-control" placeholder="Add tag..." @bind="_newTagInput" @bind:event="oninput" @onkeyup="HandleTagKeyUp" />
                            <button type="button" class="btn btn-outline-primary" @onclick="AddTag" disabled="@string.IsNullOrWhiteSpace(_newTagInput)">
                                <i class="bi bi-plus-lg me-1"></i> Add Tag
                            </button>
                        </div>
                    }
                </div>
            }
            else if (Model.ItemDataType is ItemDataType.InventoryItem)
            {
                <div class="row mb-3">
                    <div class="col-12 mb-2">
                        <label>Target Item</label>
                        <div class="input-group">
                            <InputText @bind-Value="SelectedItemDisplay" class="form-control" disabled placeholder="No Item Selected..." readonly="@(!HasPermission(Permissions.EditStore))" />
                            @if (HasPermission(Permissions.EditStore))
                            {
                                <button type="button" class="btn btn-secondary" @onclick="ShowItemPicker">
                                    <i class="bi bi-search"></i> Select
                                </button>
                            }
                        </div>
                        <ValidationMessage For="@(() => Model.InventoryItem.ItemId)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col"><label>Cost</label>
                        <InputNumber @bind-Value="Model.InventoryItem.Cost" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
                    </div>
                    <div class="col"><label>Amount</label>
                        <InputNumber @bind-Value="Model.InventoryItem.Amount" class="form-control" readonly="@(!HasPermission(Permissions.EditStore))" />
                    </div>
                    <div class="col"><label>Rarity</label>
                        <InputSelect @bind-Value="Model.InventoryItem.Rarity" class="form-select" disabled="@(!HasPermission(Permissions.EditStore))">
                            <option value="@Rarity.None">None</option>
                            <option value="@Rarity.Common">Common</option>
                            <option value="@Rarity.Uncommon">Uncommon</option>
                            <option value="@Rarity.Epic">Epic</option>
                            <option value="@Rarity.Rare">Rare</option>
                            <option value="@Rarity.Legendary">Legendary</option>
                        </InputSelect>
                    </div>
                </div>
            }
        </div>

        @if (HasPermission(Permissions.EditStore))
        {
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Save Item</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
            </div>
        }
    </EditForm>
}

@if (_showItemPicker)
{
    <div class="modal-backdrop" @onclick="CloseModals" style="background-color: rgba(0,0,0,0.5); position: fixed; inset: 0; z-index: 1040; display: flex; justify-content: center; align-items: center;">
        <div class="modal-content add-modal bg-white p-4 rounded shadow-lg" style="width: 90%; max-width: 600px; max-height: 80vh; overflow-y: auto;" @onclick:stopPropagation>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="modal-title m-0">Select Target Item</h3>
                <button class="btn-close" @onclick="CloseModals"></button>
            </div>
            <hr class="modal-divider" />

            <input type="text" placeholder="Search catalog..." @bind="ItemAddSearchTerm" @bind:event="oninput" class="form-control mb-3" />

            <div class="catalog-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px;">
                @foreach (var catItem in ItemAddCatalogFiltered)
                {
                    <div class="card catalog-item @(SelectedItemToAdd?.Id == catItem.Id ? "border-primary" : "")" style="cursor: pointer;" @onclick="() => SelectedItemToAdd = catItem">
                        <div class="card-body text-center p-2">
                            <img @key="catItem.Id" src="/static/genoa-textures/ui/items/@(GetTextureName(catItem)).png" alt="@catItem.Name" onerror="this.onerror=null; this.src='/static/missing_texture.png';" style="max-width: 48px;" />
                            <div class="cat-item-name mt-2 small fw-bold text-truncate">@catItem.Name</div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-pagination d-flex justify-content-between align-items-center mt-3">
                <button @onclick="PrevAddPage" disabled="@(!ItemCanGoPrevAdd)" class="btn btn-outline-primary btn-sm">Prev</button>
                <span class="pag-info text-sm">Page @ItemAddCurrentPage of @ItemAddTotalPages</span>
                <button @onclick="NextAddPage" disabled="@(!ItemCanGoNextAdd)" class="btn btn-outline-primary btn-sm">Next</button>
            </div>

            @if (SelectedItemToAdd is not null)
            {
                <div class="add-controls mt-3 d-flex justify-content-end">
                    <button class="btn btn-success" @onclick="ConfirmItemSelection">Select Item</button>
                </div>
            }
        </div>
    </div>
}

@if (_showBuildplatePicker)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header d-flex flex-wrap align-items-center gap-2">
                    <h5 class="modal-title mb-0 text-truncate me-auto">Select Target Buildplate</h5>

                    <div class="flex-grow-1 flex-md-grow-0" style="min-width: 200px; max-width: 300px;">
                        <SearchBar @bind-Value="_templateSearchTerm" Placeholder="name or ID" OnSearch="SearchTemplateAsync" OnClear="ClearTemplateSearch" />
                    </div>

                    <button type="button" class="btn-close ms-1" @onclick="CloseModals"></button>
                </div>

                <div class="modal-body bg-light">
                    <PagedDataView @ref="_templatePagedView" TData="List<Players.Buildplates.TemplateViewModel>" DefaultPageSize="6" Provider="FetchTemplateDataAsync" OnDataLoaded="HandleTemplateDataLoaded" Context="data">
                        <div class="row g-3">
                            @foreach (var template in data)
                            {
                                <div class="col-12 col-md-6 col-lg-4" @key="template.Id">
                                    <div class="card h-100 shadow-sm">
                                        <Solace.WebPortal.Client.Features.Buildplates.BuildplatePreview BuildplateId="@template.Id" IsTemplate=true BlocksPerMeter="@template.BlocksPerMeter" IsNight="@template.IsNight" />

                                        <div class="card-body p-3 d-flex flex-column">
                                            <h6 class="mb-1 fw-bold text-truncate" title="@template.Name">@template.Name</h6>
                                            <small class="text-muted mb-3 d-block">Size: @(template.Size)x@(template.Size) | BPM: @template.BlocksPerMeter</small>

                                            <button class="btn btn-sm btn-success mt-auto fw-bold" @onclick="() => ConfirmBuildplateSelection(template)">
                                                <i class="bi bi-check-circle me-1"></i> Select Buildplate
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </PagedDataView>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private ClaimsPrincipal? _user;
    private ItemViewModel Model { get; set; } = new();
    private bool DataLoaded;

    private Catalog.CatalogCacheService? CatalogService { get; set; }

    private string SelectedBuildplateDisplay = string.Empty;
    private string SelectedItemDisplay = string.Empty;

    private string _newTagInput = string.Empty;

    private bool _showItemPicker = false;
    private bool _showBuildplatePicker = false;
    private bool _showTranslations = false;
    private string _selectedLanguageToAdd = string.Empty;

    private static readonly List<(string Code, string DisplayName)> AvailableLanguages = Constants.LanguageNames
        .Select(kvp => (Code: kvp.Key, DisplayName: kvp.Value))
        .OrderBy(c => c.DisplayName)
        .ToList();

    private HashSet<string> ActiveTranslationCodes
    {
        get
        {
            return Model.TitleTranslations.Keys
                .Union(Model.DescriptionTranslations.Keys)
                .ToHashSet();
        }
    }

    private Catalog.CatalogCacheService.SyncAccessor Catalog;

    private List<CatalogItemDto> ItemFullCatalogFiltered = [];

    private string _itemAddSearchTerm = "";
    private string ItemAddSearchTerm
    {
        get => _itemAddSearchTerm;
        set
        {
            _itemAddSearchTerm = value;
            ItemAddCurrentPage = 1;
            ItemFullCatalogFiltered = Catalog.Search(value).ToList();
        }
    }

    private IEnumerable<CatalogItemDto> ItemAddCatalogFiltered => ItemFullCatalogFiltered
       .Skip((ItemAddCurrentPage - 1) * ItemAddPageSize)
       .Take(ItemAddPageSize);
    private CatalogItemDto? SelectedItemToAdd = null;

    private int ItemAddCurrentPage { get; set; } = 1;
    private int ItemAddPageSize = 10;

    private int ItemAddTotalPages => int.Max(1, (int)double.Ceiling(ItemFullCatalogFiltered.Count / (double)ItemAddPageSize));
    private bool ItemCanGoPrevAdd => ItemAddCurrentPage > 1;
    private bool ItemCanGoNextAdd => ItemAddCurrentPage < ItemAddTotalPages;

    private string _templateSearchTerm = string.Empty;
    private PagedDataView<List<Players.Buildplates.TemplateViewModel>>? _templatePagedView;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // cannot inject, bcs it's not available when prerendering
            CatalogService = ServiceProvider.GetRequiredService<Catalog.CatalogCacheService>();
            Catalog = await CatalogService.GetSyncAccessorAsync();

            if (Id.HasValue)
            {
                Model = ItemViewModel.FromDto((await Http.GetFromJsonAsync<ItemDto>($"api/store/items/{Id.Value}"))!);

                if (!string.IsNullOrEmpty(Model.Buildplate.BuildplateName))
                {
                    SelectedBuildplateDisplay = Model.Buildplate.BuildplateName;
                }

                if (!string.IsNullOrEmpty(Model.InventoryItem.ItemName))
                {
                    SelectedItemDisplay = Model.InventoryItem.ItemName;
                }
            }

            DataLoaded = true;

            StateHasChanged();
        }
    }

    private string GetLanguageDisplayName(string code)
    {
        if (Constants.LanguageNames.TryGetValue(code, out var name))
        {
            return name;
        }

        return code;
    }

    private void AddLanguageTranslation()
    {
        if (string.IsNullOrWhiteSpace(_selectedLanguageToAdd))
        {
            return;
        }

        if (!Model.TitleTranslations.ContainsKey(_selectedLanguageToAdd))
        {
            Model.TitleTranslations[_selectedLanguageToAdd] = string.Empty;
        }

        if (!Model.DescriptionTranslations.ContainsKey(_selectedLanguageToAdd))
        {
            Model.DescriptionTranslations[_selectedLanguageToAdd] = string.Empty;
        }

        _selectedLanguageToAdd = string.Empty;
    }

    private void RemoveLanguageTranslation(string code)
    {
        Model.TitleTranslations.Remove(code);
        Model.DescriptionTranslations.Remove(code);
    }

    private string GetTranslation(Dictionary<string, string> dict, string code)
    {
        if (dict.TryGetValue(code, out var val))
        {
            return val;
        }

        return string.Empty;
    }

    private void SetTranslation(Dictionary<string, string> dict, string code, string? value)
    {
        dict[code] = value ?? string.Empty;
    }

    private void ShowItemPicker()
    {
        ItemAddCurrentPage = 1;
        SelectedItemToAdd = null;
        ItemAddSearchTerm = "";
        _showItemPicker = true;
    }

    private void CloseModals()
    {
        _showItemPicker = false;
        _showBuildplatePicker = false;
    }

    private void ConfirmItemSelection()
    {
        if (SelectedItemToAdd is not null)
        {
            Model.InventoryItem.ItemId = SelectedItemToAdd.Id;
            SelectedItemDisplay = SelectedItemToAdd.Name;
            CloseModals();
        }
    }

    private void ConfirmBuildplateSelection(Players.Buildplates.TemplateViewModel template)
    {
        if (template is not null)
        {
            Model.Buildplate.BuildplateId = template.Id;
            SelectedBuildplateDisplay = template.Name;
            CloseModals();
        }
    }

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(_newTagInput))
        {
            Model.Buildplate.Tags.Add(_newTagInput.Trim());
            _newTagInput = string.Empty;
        }
    }

    private void RemoveTag(string tag)
    {
        Model.Buildplate.Tags.Remove(tag);
    }

    private void HandleTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/Store");
    }

    private async Task HandleSubmit()
    {
        HttpResponseMessage response;
        if (Id.HasValue)
        {
            response = await Http.PutAsJsonAsync($"api/store/items/{Id.Value}", Model.ToDto());
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/store/items", Model.ToDto());
        }

        if (response.IsSuccessStatusCode)
        {
            NavManager.NavigateTo("/Store");
        }
    }

    private static string GetTextureName(CatalogItemDto item)
    {
        if (item.Category is CatalogItemDtoCategory.BoostAdventureXP or CatalogItemDtoCategory.BoostCrafting or CatalogItemDtoCategory.BoostDefense or CatalogItemDtoCategory.BoostEating or CatalogItemDtoCategory.BoostHealth or CatalogItemDtoCategory.BoostHoarding or CatalogItemDtoCategory.BoostItemXP or CatalogItemDtoCategory.BoostMiningSpeed or CatalogItemDtoCategory.BoostRetention or CatalogItemDtoCategory.BoostSmelting or CatalogItemDtoCategory.BoostStrength or CatalogItemDtoCategory.BoostTappableRadius)
        {
            return item.Id.ToString();
        }

        return item.Name + "_" + item.Aux;
    }

    private void PrevAddPage()
    {
        if (ItemCanGoPrevAdd)
        {
            ItemAddCurrentPage--;
        }
    }

    private void NextAddPage()
    {
        if (ItemCanGoNextAdd)
        {
            ItemAddCurrentPage++;
        }
    }

    private async Task SearchTemplateAsync()
    {
        if (_templatePagedView is not null)
        {
            await _templatePagedView.SearchAsync(_templateSearchTerm);
        }
    }

    private async Task ClearTemplateSearch()
    {
        _templateSearchTerm = string.Empty;
        await SearchTemplateAsync();
    }

    private async Task<PagedResult<List<Players.Buildplates.TemplateViewModel>>?> FetchTemplateDataAsync(PagedSearchQuery query)
    {
        try
        {
            var uri = $"/api/buildplates/templates?searchTerm={Uri.EscapeDataString(query.SearchTerm ?? string.Empty)}&page={query.Page}&pageSize={query.PageSize}";
            var response = await Http.GetFromJsonAsync<PagedSearchResult<List<WebPortal.Common.Features.Buildplates.BuildplateTemplateDto>>>(uri);

            if (response is null)
            {
                return null;
            }

            var buildplates = response.Data
                .Select(dto => new Players.Buildplates.TemplateViewModel
                {
                    Id = dto.Id,
                    Name = dto.Name,
                    Size = dto.Size,
                    BlocksPerMeter = dto.BlocksPerMeter,
                    IsNight = dto.IsNight,
                })
                .ToList();

            return new PagedSearchResult<List<Players.Buildplates.TemplateViewModel>>(buildplates, response.TotalCount, response.MatchingCount);
        }
        catch
        {
            _templatePagedView?.ErrorMessage = "Failed to load templates.";
            return null;
        }
    }

