@page "/Players/{PlayerId:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Solace.WebPortal.Common
@attribute [Authorize(Policy = Permissions.ViewPlayers)]
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Player Profile - Solace</PageTitle>

<div class="container mt-3 mb-5" style="max-width: 900px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-secondary btn-sm" href="/Players">
            <i class="bi bi-arrow-left"></i> Back to Players
        </a>

        @if (_user.HasPermission(Permissions.ManagePlayers))
        {
            <button class="btn btn-danger btn-sm" @onclick="OpenDeleteModal">
                <i class="bi bi-trash me-1"></i> Delete Player
            </button>
        }
    </div>

    <ProfileDisplay @ref="@_profileDisplay" ProfileId="@PlayerId" DisplayOwner="true" />

    @if (IsDeleteModalVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content shadow-lg border-danger">
                    <div class="modal-header py-2 bg-danger text-white">
                        <h6 class="modal-title font-weight-bold" style="font-size: 0.9rem;">Confirm Deletion</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal" disabled="@IsDeletingPlayer"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="mb-3 text-dark" style="font-size: 0.85rem;">
                            Are you sure you want to delete player <strong>@(_profileDisplay?.PlayerAccount?.Username ?? "[unknown]")</strong>? This action cannot be undone.
                        </p>

                        @if (!string.IsNullOrEmpty(DeleteErrorMessage))
                        {
                            <div class="alert alert-danger py-1 px-2 mb-2 small" role="alert" style="font-size: 0.75rem;">@DeleteErrorMessage</div>
                        }

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseDeleteModal" disabled="@IsDeletingPlayer">Cancel</button>
                            <button type="button" class="btn btn-danger btn-sm px-3" @onclick="DeletePlayerAsync" disabled="@IsDeletingPlayer">
                                @if (IsDeletingPlayer)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <span>Delete</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid PlayerId { get; set; }

    private ProfileDisplay? _profileDisplay;

    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
    }

    private bool IsDeleteModalVisible { get; set; } = false;
    private bool IsDeletingPlayer { get; set; } = false;
    private string? DeleteErrorMessage { get; set; }

    private void OpenDeleteModal()
    {
        DeleteErrorMessage = null;
        IsDeleteModalVisible = true;
    }

    private void CloseDeleteModal()
    {
        IsDeleteModalVisible = false;
        DeleteErrorMessage = null;
    }

    private async Task DeletePlayerAsync()
    {
        if (_profileDisplay?.PlayerAccount is null)
        {
            return;
        }

        IsDeletingPlayer = true;
        DeleteErrorMessage = null;

        try
        {
            var uri = $"api/players/{PlayerId}";
            using var response = await Http.DeleteAsync(uri);

            if (response.IsSuccessStatusCode)
            {
                IsDeleteModalVisible = false;
                NavManager.NavigateTo("/Players");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                DeleteErrorMessage = string.IsNullOrEmpty(error) ? "Failed to delete player account." : error;
            }
        }
        catch
        {
            DeleteErrorMessage = "An error occurred while deleting the player.";
        }
        finally
        {
            IsDeletingPlayer = false;
        }
    }
}