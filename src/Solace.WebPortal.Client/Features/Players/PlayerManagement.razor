@page "/Admin/Players"
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Players
@using System.Security.Claims
@using System.Globalization
@attribute [Authorize(Policy = Permissions.ViewPlayers)]
@rendermode InteractiveWebAssembly
@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<PlayerManagement> Logger

<PageTitle>Player Management - Solace</PageTitle>

<div class="container-fluid py-3 px-md-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="h3 mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Players</h2>
                <span class="badge bg-dark-subtle text-dark border p-2">
                    Total: @(_totalPlayers?.ToString() ?? "?")
                </span>
            </div>
            <p class="text-muted small mb-0">Manage accounts and player statistics</p>
        </div>

        <div class="input-group" style="max-width: 400px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Search by username or ID..." @bind="_searchTerm" @bind:after="SearchAsync" />
            @if (!string.IsNullOrEmpty(_searchTerm))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>@_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if ((_players is null || _loading) && _errorMessage is null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_players is not null && !_loading)
    {
        <div class="d-none d-md-block card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th class="text-center">Level</th>
                            <th class="text-center">Health</th>
                            <th class="text-center">Rubies</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in _players)
                        {
                            <tr>
                                <td>
                                    <span role="button" class="text-primary small text-decoration-none user-select-all" @onclick="() => CopyIdAsync(player.Id)" title="Click to copy ID">
                                        <code>@player.Id</code>
                                    </span>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(player.Username))
                                    {
                                        <span class="text-muted fst-italic">No Username</span>
                                        <span class="badge rounded-pill bg-info text-dark ms-1" style="font-size: 0.75rem;">
                                            Microsoft Account
                                        </span>
                                    }
                                    else
                                    {
                                        @player.Username
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                        <svg viewBox="0 0 36 36" class="position-absolute top-0 start-0 w-100 h-100">
                                            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e9ecef" stroke-width="3" />
                                            @{
                                                var progress = player.LevelProgressPercentage.HasValue ? (player.LevelProgressPercentage.Value * 100).ToString("0.0", CultureInfo.InvariantCulture) : "100";
                                                var strokeColor = player.LevelProgressPercentage.HasValue ? "#0d6efd" : "#198754";
                                            }
                                            <path stroke-dasharray="@progress, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="@strokeColor" stroke-width="3" />
                                        </svg>
                                        <span class="fw-bold" style="font-size: 0.85rem;">@player.Level</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="text-success fw-medium text-nowrap"><i class="bi bi-heart-fill me-1"></i>@player.Health / @player.MaxHealth</span>
                                </td>
                                <td class="text-center text-danger fw-bold" title="Purchased: @player.PurchasedRubies | Earned: @player.EarnedRubies">
                                    <i class="bi bi-gem me-1"></i>@player.TotalRubies
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/Players/@(player.Id)" class="btn btn-sm btn-outline-primary me-1" title="Profile">
                                        <i class="bi bi-person-fill me-1"></i>Profile
                                    </a>
                                    @if (HasPermission(Permissions.ManagePlayers))
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlayerAsync(player.Id, player.Username)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-md-none">
            @foreach (var player in _players)
            {
                <div class="card mb-3 shadow-sm border-start border-primary border-4">
                    <div class="card-body">
                        <div class="mb-2">
                            <small class="text-muted d-block" role="button" @onclick="() => CopyIdAsync(player.Id)" title="Click to copy ID">
                                ID: <span class="text-primary">@player.Id</span>
                            </small>
                            <div class="fw-bold">
                                @if (string.IsNullOrEmpty(player.Username))
                                {
                                    <span class="text-muted fst-italic fw-normal">No Username</span>
                                    <span class="badge rounded-pill bg-info text-dark ms-1" style="font-size: 0.75rem;">
                                        Microsoft Account
                                    </span>
                                }
                                else
                                {
                                    @player.Username
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 mb-2">
                            <div class="d-flex align-items-center">
                                <div class="position-relative d-inline-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
                                    <svg viewBox="0 0 36 36" class="position-absolute top-0 start-0 w-100 h-100">
                                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#dee2e6" stroke-width="3.5" />
                                        @{
                                            var progressMobile = player.LevelProgressPercentage.HasValue ? (player.LevelProgressPercentage.Value * 100).ToString("0.0", CultureInfo.InvariantCulture) : "100";
                                            var strokeColorMobile = player.LevelProgressPercentage.HasValue ? "#0d6efd" : "#198754";
                                        }
                                        <path stroke-dasharray="@progressMobile, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="@strokeColorMobile" stroke-width="3.5" />
                                    </svg>
                                    <span class="fw-bold" style="font-size: 0.8rem;">@player.Level</span>
                                </div>
                                <span class="text-success small fw-medium text-nowrap"><i class="bi bi-heart-fill me-1"></i>@player.Health / @player.MaxHealth</span>
                            </div>
                            <div>
                                <span class="text-danger fw-bold small text-nowrap" title="Purchased: @player.PurchasedRubies | Earned: @player.EarnedRubies">
                                    <i class="bi bi-gem me-1"></i>@player.TotalRubies
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <a href="/Admin/Players/@(player.Id)" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-person-fill me-1"></i>Profile
                            </a>
                            @if (HasPermission(Permissions.ManagePlayers))
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlayerAsync(player.Id, player.Username)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_totalPages > 1)
        {
            <nav aria-label="Player page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(1)" aria-label="First">
                            <span aria-hidden="true">&laquo;</span>
                        </button>
                    </li>
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(_currentPage - 1)" aria-label="Previous">
                            <span aria-hidden="true">&lsaquo;</span>
                        </button>
                    </li>
                    <li class="page-item disabled d-none d-sm-block">
                        <span class="page-link">Page @_currentPage of @_totalPages</span>
                    </li>
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(_currentPage + 1)" aria-label="Next">
                            <span aria-hidden="true">&rsaquo;</span>
                        </button>
                    </li>
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePageAsync(_totalPages)" aria-label="Last">
                            <span aria-hidden="true">&raquo;</span>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    private bool _loading;
    private ClaimsPrincipal? _user;
    private List<AccountViewModel>? _players;
    private string? _errorMessage;

    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private int? _totalPlayers = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task SearchAsync()
    {
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await SearchAsync();
    }

    private async Task ChangePageAsync(int newPage)
    {
        if (newPage >= 1 && newPage <= _totalPages && newPage != _currentPage)
        {
            _currentPage = newPage;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var uri = $"api/admin/players?searchTerm={Uri.EscapeDataString(_searchTerm)}&page={_currentPage}&pageSize={_pageSize}";
            var response = await Http.GetFromJsonAsync<GetPlayersResponse>(uri);

            if (response is not null)
            {
                _players = response.Players
                    .Select(account => new AccountViewModel
                    {
                        Id = account.Id,
                        Username = account.Username,
                        Health = account.Health,
                        MaxHealth = account.MaxHealth,
                        Level = account.Level,
                        LevelProgressPercentage = account.LevelProgressPercentage,
                        PurchasedRubies = account.PurchasedRubies,
                        EarnedRubies = account.EarnedRubies,
                    })
                    .ToList();

                _totalPlayers = response.TotalPlayers;
                _totalPages = response.TotalPages;
                _currentPage = response.CurrentPage;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to get accounts");
            _errorMessage = "Failed to load players.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeletePlayerAsync(Guid id, string? username)
    {
        if (!HasPermission(Permissions.ManagePlayers))
        {
            return;
        }

        if (_players is null)
        {
            return;
        }

        string confirmText = string.IsNullOrEmpty(username)
            ? $"Are you sure you want to permanently delete player with id '{id}'?"
            : $"Are you sure you want to permanently delete player '{username}', id: {id}?";

        bool confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (!confirmed)
        {
            return;
        }

        try
        {
            var uri = $"api/admin/players/{id}";
            var response = await Http.DeleteAsync(uri);

            if (response is { IsSuccessStatusCode: true } or { StatusCode: System.Net.HttpStatusCode.NotFound })
            {
                await LoadDataAsync();

                Logger.LogInformation("Deleted player {PlayerId}", id);
            }
            else
            {
                _errorMessage = $"Failed to delete player ({response.StatusCode}).";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete player {PlayerId}", id);
            _errorMessage = "Failed to delete player.";
        }
    }

    private async Task CopyIdAsync(Guid id)
    {
        await JS.InvokeVoidAsync("copyTextDirect", id.ToString());
    }

    private bool HasPermission(string permission)
        => _user?.HasPermission(permission) ?? false;

    public sealed class AccountViewModel
    {
        public Guid Id { get; set; }

        public string? Username { get; set; }

        public int Health { get; set; }

        public int MaxHealth { get; set; }

        public int Level { get; set; }

        public float? LevelProgressPercentage { get; set; } // 0 to 1; null - max level already

        public int EarnedRubies { get; set; }

        public int PurchasedRubies { get; set; }

        public int TotalRubies => EarnedRubies + PurchasedRubies;
    }
}