@page "/Data"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.Net
@using System.Net.Http.Json
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Data
@attribute [Authorize(Policy = Permissions.ViewData)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject AntiforgeryStateProvider AntiforgeryStateProvider
@inject ILogger<DataManagement> Logger

<PageTitle>Data - Solace</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">Data Management</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Space Usage</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 border-end">
                    <h6 class="text-muted">Total Space Used</h6>
                    <h3 class="text-primary">@FormatBytes(_totalSpaceB)</h3>
                </div>
                <div class="col-md-9">
                    <h6 class="text-muted">Storage Split</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 pb-1">
                            <div class="d-flex justify-content-between align-items-center fw-semibold">
                                <span><i class="bi bi-database"></i> Databases</span>
                                <span class="badge bg-secondary rounded-pill">@FormatBytes(_totalDbB)</span>
                            </div>
                            <ul class="list-group list-group-flush ms-3 mt-1">
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-1 text-muted small">
                                    <span>EarthDb</span>
                                    <span>@FormatBytes(_earthDbB)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-1 text-muted small">
                                    <span>WebPortalDb</span>
                                    <span>@FormatBytes(_webPortalDbB)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-1 text-muted small">
                                    <span>PlayfabDb</span>
                                    <span>@FormatBytes(_playfabDbB)</span>
                                </li>
                            </ul>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center fw-semibold pt-2">
                            <span><i class="bi bi-folder"></i> Object Store</span>
                            <span class="badge bg-secondary rounded-pill">@FormatBytes(_objectStoreB)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @if (HasPermission(Permissions.ExportData))
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Export Data</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Backup your current server data.</p>
                <button class="btn btn-outline-primary" @onclick="ExportData">
                    <i class="bi bi-download me-1"></i> Export Data
                </button>
            </div>
        </div>
    }

    @if (HasPermission(Permissions.EditData))
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Edit Data</h5>
            </div>
            <div class="card-body">
                <section class="mb-4">
                    <h6><i class="bi bi-file-earmark-zip me-1"></i> Import Data</h6>
                    <p class="small text-muted mb-3">
                        Upload a backup ZIP file to restore or update server data.
                    </p>
                    <button class="btn btn-primary" @onclick="OpenImportModal">
                        <i class="bi bi-cloud-upload me-1"></i> Import Data
                    </button>
                </section>

                <hr />

                <section class="mt-2">
                    <h6 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Danger Zone</h6>
                    <p class="small text-muted">
                        Deleting all server data is a permanent action and cannot be undone.
                    </p>

                    @if (!_isConfirmingDelete)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="InitiateDelete">
                            Delete All Data
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <div class="me-auto">
                                <strong>Are you absolutely sure?</strong>
                                @if (!_canConfirmDelete)
                                {
                                    <span class="ms-1 text-dark"> Please wait @_countdown seconds...</span>
                                }
                            </div>
                            <div>
                                <button class="btn btn-sm btn-secondary me-2" @onclick="CancelDelete">Cancel</button>
                                <button class="btn btn-sm btn-danger" disabled="@(!_canConfirmDelete)" @onclick="ExecuteDelete">
                                    Yes, Delete Everything
                                </button>
                            </div>
                        </div>
                    }
                </section>
            </div>
        </div>
    }
</div>

@if (_showImportModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-zip me-2 text-primary"></i>Import Data
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseImportModal" disabled="@_isImporting" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <fieldset disabled="@_isImporting">
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Backup File (.zip)</label>
                            <InputFile @key="_inputFileId" OnChange="HandleFileSelected" class="form-control" accept=".zip" />

                            @if (_selectedFile is not null)
                            {
                                <div class="form-text text-success small mt-2 d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Ready to upload: <strong>@_selectedFile.Name</strong> &nbsp;(@FormatBytes(_selectedFile.Size))
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold d-block mb-2">Conflict Resolution Strategy</label>
                            <div class="d-flex flex-column gap-2">
                                <label class="conflict-option p-3 rounded d-flex align-items-start @(_conflictResolution == DataConflictResolution.Ignore ? "selected-ignore" : "")">
                                    <input class="form-check-input flex-shrink-0 mt-1 me-3" type="radio" name="conflict-resolution-modal" checked="@(_conflictResolution == DataConflictResolution.Ignore)" @onchange="() => _conflictResolution = DataConflictResolution.Ignore" />
                                    <div>
                                        <div class="fw-semibold text-primary">
                                            <i class="bi bi-shield-check me-1"></i> Ignore Existing Records
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Skip records that already exist in the database. Only missing or new entities will be added.
                                        </div>
                                    </div>
                                </label>

                                <label class="conflict-option p-3 rounded d-flex align-items-start @(_conflictResolution == DataConflictResolution.Overwrite ? "selected-overwrite" : "")">
                                    <input class="form-check-input flex-shrink-0 mt-1 me-3" type="radio" name="conflict-resolution-modal" checked="@(_conflictResolution == DataConflictResolution.Overwrite)" @onchange="() => _conflictResolution = DataConflictResolution.Overwrite" />
                                    <div>
                                        <div class="fw-semibold text-danger">
                                            <i class="bi bi-arrow-repeat me-1"></i> Overwrite Existing Records
                                        </div>
                                        <div class="small text-muted mt-1">
                                            Replace existing records with matching keys from the ZIP backup. Existing field values will be overwritten.
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    @if (_isImporting)
                    {
                        <div class="mt-4 pt-2 border-top">
                            <div class="d-flex justify-content-between small text-muted mb-1 fw-semibold">
                                <span>@_importStageText</span>
                                <span>@($"{_importProgressPercent:F0}%") (@FormatBytes(_bytesUploaded) / @FormatBytes(_totalBytesToUpload))</span>
                            </div>
                            <div class="progress" style="height: 12px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                     role="progressbar"
                                     style="width: @_importProgressPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                     aria-valuenow="@_importProgressPercent"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="alert alert-danger d-flex align-items-center mt-3 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@_uploadError</div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isImporting" @onclick="CloseImportModal">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@(_selectedFile is null || _isImporting)" @onclick="InitiateImport">
                        @if (_isImporting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-upload me-1"></i>
                            <span>Start Import</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_isProcessing)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-transparent border-0 text-center">
                <div class="modal-body text-white">
                    <div class="spinner-border text-light mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5>@_processingAction...</h5>
                    <p class="small text-light opacity-75">Please do not close this page.</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ClaimsPrincipal? _user;

    // View states - Delete/Export
    private bool _isConfirmingDelete = false;
    private bool _canConfirmDelete = false;
    private int _countdown = 5;
    private bool _isProcessing = false;
    private string _processingAction = "";
    private string? _errorMessage;

    // View states - Import Modal
    private bool _showImportModal = false;
    private bool _isImporting = false;
    private double _importProgressPercent = 0;
    private long _bytesUploaded = 0;
    private long _totalBytesToUpload = 0;
    private string _importStageText = "";

    private Guid _inputFileId = Guid.NewGuid();

    // Import inputs
    private IBrowserFile? _selectedFile;
    private string? _uploadError;
    private DataConflictResolution _conflictResolution = DataConflictResolution.Ignore;

    // Sizes
    private long _earthDbB = -1;
    private long _webPortalDbB = -1;
    private long _playfabDbB = -1;
    private long _objectStoreB = -1;

    private long _totalDbB => (_earthDbB >= 0 && _webPortalDbB >= 0 && _playfabDbB >= 0)
        ? (_earthDbB + _webPortalDbB + _playfabDbB)
        : -1;

    private long _totalSpaceB => (_totalDbB >= 0 && _objectStoreB >= 0)
        ? (_totalDbB + _objectStoreB)
        : -1;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthenticationStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> task)
    {
        var authState = await task;
        _user = authState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = Task.Run(async () =>
            {
                await LoadSizesAsync();
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task LoadSizesAsync()
    {
        _errorMessage = null;
        var uri = "api/data/size";

        try
        {
            var response = await Http.GetAsync(uri);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GetSizeResponse>();
                if (result is not null)
                {
                    _earthDbB = result.EarthDb;
                    _webPortalDbB = result.WebPortalDb;
                    _playfabDbB = result.PlayfabDb;
                    _objectStoreB = result.ObjectStore;
                    return;
                }
            }

            var content = await response.Content.ReadAsStringAsync();
            _errorMessage = !string.IsNullOrWhiteSpace(content)
                ? $"Failed to retrieve size data: {content}"
                : $"Failed to retrieve size data. Status Code: {response.StatusCode}";

            Logger.LogError("Failed to fetch storage sizes: {Content}", content);
        }
        catch (Exception exception)
        {
            _errorMessage = "An unexpected error occurred while retrieving storage sizes.";
            Logger.LogError(exception, "Error occurred in LoadSizesAsync.");
        }
    }

    private bool HasPermission(string permission)
        => _user?.HasPermission(permission) ?? false;

    private async Task ExportData()
    {
        _processingAction = "Exporting Data";
        _isProcessing = true;

        try
        {
            await JS.InvokeVoidAsync("triggerFileDownload", "solace-data-export.zip", "api/data/export");
        }
        catch (Exception exception)
        {
            _errorMessage = "An unexpected error occurred during data export.";
            Logger.LogError(exception, "Error occurred in ExportData.");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void OpenImportModal()
    {
        _uploadError = null;
        _selectedFile = null;
        _conflictResolution = DataConflictResolution.Ignore;
        _inputFileId = Guid.NewGuid();
        _isImporting = false;
        _importProgressPercent = 0;
        _bytesUploaded = 0;
        _totalBytesToUpload = 0;
        _showImportModal = true;
    }

    private void CloseImportModal()
    {
        if (_isImporting)
        {
            return;
        }

        _showImportModal = false;
        _selectedFile = null;
        _uploadError = null;
    }

    private async Task InitiateImport()
    {
        if (_selectedFile is null || _isImporting)
        {
            return;
        }

        _isImporting = true;
        _uploadError = null;
        _importProgressPercent = 0;
        _bytesUploaded = 0;
        _totalBytesToUpload = _selectedFile.Size;
        _importStageText = "Uploading backup archive...";

        try
        {
            var token = AntiforgeryStateProvider.GetAntiforgeryToken();

            using var content = new MultipartFormDataContent();
            await using var fileStream = _selectedFile.OpenReadStream(1024L * 1024L * 1024L);

            var progressContent = new ProgressStreamContent(
                fileStream,
                _selectedFile.Size,
                81920,
                (uploaded, total) =>
                {
                    _bytesUploaded = uploaded;
                    _totalBytesToUpload = total;
                    _importProgressPercent = total > 0 ? Math.Min(100.0, ((double)uploaded / total) * 100.0) : 0;
                    
                    if (uploaded >= total)
                    {
                        _importStageText = "Processing backup on server...";
                    }

                    _ = InvokeAsync(StateHasChanged);
                });

            content.Add(progressContent, "File", _selectedFile.Name);
            content.Add(new StringContent(_conflictResolution.ToString()), "ConflictResolution");

            using var request = new HttpRequestMessage(HttpMethod.Post, "api/data/import")
            {
                Content = content,
            };

            if (token is not null)
            {
                request.Headers.Add("RequestVerificationToken", token.Value);
            }

            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                _uploadError = string.IsNullOrWhiteSpace(message)
                    ? $"Import failed. Status Code: {response.StatusCode}"
                    : message;
                return;
            }

            _selectedFile = null;
            _inputFileId = Guid.NewGuid();
            _showImportModal = false;
        }
        catch (Exception exception)
        {
            _uploadError = "An unexpected error occurred during import.";
            Logger.LogError(exception, "Error occurred in InitiateImport.");
        }
        finally
        {
            _isImporting = false;
            await LoadSizesAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitiateDelete()
    {
        _isConfirmingDelete = true;
        _canConfirmDelete = false;
        _countdown = 5;

        while (_countdown > 0 && _isConfirmingDelete)
        {
            await Task.Delay(1000);
            _countdown--;
        }

        if (_isConfirmingDelete)
        {
            _canConfirmDelete = true;
        }
    }

    private void CancelDelete()
    {
        _isConfirmingDelete = false;
        _canConfirmDelete = false;
    }

    private async Task ExecuteDelete()
    {
        _errorMessage = null;
        _processingAction = "Deleting Data";
        _isProcessing = true;

        try
        {
            var uri = "api/data/delete-all";
            var response = await Http.PostAsync(uri, null);

            if (response.IsSuccessStatusCode)
            {
                _earthDbB = -1;
                _webPortalDbB = -1;
                _objectStoreB = -1;

                _ = Task.Run(async () =>
                {
                    await LoadSizesAsync();
                    await InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                _errorMessage = !string.IsNullOrWhiteSpace(content)
                    ? $"Deletion failed: {content}"
                    : $"Deletion failed. Status Code: {response.StatusCode}";

                Logger.LogError("Delete operation failed: {Content}", content);
            }
        }
        catch (Exception exception)
        {
            _errorMessage = "An unexpected error occurred during data deletion.";
            Logger.LogError(exception, "Error occurred in ExecuteDelete.");
        }
        finally
        {
            _isProcessing = false;
            _isConfirmingDelete = false;
            _canConfirmDelete = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _selectedFile = e.File;

        if (!_selectedFile.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            _uploadError = "Please select a valid .zip file.";
            _selectedFile = null;
        }
    }

    private static readonly string[] SizeUnits = ["B", "KB", "MB", "GB", "TB", "PB"];

    private string FormatBytes(long bytes)
    {
        if (bytes < 0)
        {
            return "? B";
        }

        if (bytes is 0)
        {
            return "0 B";
        }

        int unitIndex = 0;
        double displaySize = bytes;

        while (displaySize >= 1024 && unitIndex < SizeUnits.Length - 1)
        {
            displaySize /= 1024;
            unitIndex++;
        }

        return $"{displaySize:n2} {SizeUnits[unitIndex]}";
    }

    private sealed class ProgressStreamContent : HttpContent
    {
        private readonly Stream _stream;
        private readonly long _totalBytes;
        private readonly int _bufferSize;
        private readonly Action<long, long> _onProgress;

        public ProgressStreamContent(Stream stream, long totalBytes, int bufferSize, Action<long, long> onProgress)
        {
            _stream = stream;
            _totalBytes = totalBytes;
            _bufferSize = bufferSize;
            _onProgress = onProgress;
            Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
        }

        protected override async Task SerializeToStreamAsync(Stream stream, TransportContext? context)
        {
            var buffer = new byte[_bufferSize];
            long uploaded = 0;
            int bytesRead;

            while ((bytesRead = await _stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
            {
                await stream.WriteAsync(buffer.AsMemory(0, bytesRead));
                uploaded += bytesRead;
                _onProgress(uploaded, _totalBytes);
            }
        }

        protected override bool TryComputeLength(out long length)
        {
            length = _totalBytes;
            return true;
        }
    }
}