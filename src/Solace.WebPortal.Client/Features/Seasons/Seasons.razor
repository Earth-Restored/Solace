@page "/Seasons"
@using System.Globalization
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Client.Features.Common
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Seasons
@attribute [Authorize(Policy = Permissions.ViewSeasonsAndChallenges)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Seasons - Solace</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Seasons & Challenges</h2>
            <p class="text-muted mb-0">Manage Minecraft Earth seasons and DAG challenge progression.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (hasUpdateAvailable)
            {
                if (HasPermission(Permissions.EditSeasonsAndChallenges))
                {
                    <button class="btn btn-success" @onclick="OpenUpdateModal">
                        <i class="bi bi-arrow-up-circle me-1"></i> Update to v@(latestVersion)
                    </button>
                }
                else
                {
                    <button class="btn btn-success" disabled>
                        <i class="bi bi-arrow-up-circle me-1"></i> Update to v@(latestVersion) available
                    </button>
                }
            }

            @if (HasPermission(Permissions.EditSeasonsAndChallenges))
            {
                <button class="btn btn-outline-warning" @onclick="OpenResetModal">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Data
                </button>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/Seasons/Create")'>
                    <i class="bi bi-plus-lg me-1"></i> Create Season
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading seasons data...</span>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(actionErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                @actionErrorMessage
                <button type="button" class="btn-close py-2" @onclick="() => actionErrorMessage = null"></button>
            </div>
        }

        @if (seasons.Count is 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                    No seasons found in the database.
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var season in seasons)
                {
                    var visibleChallengeCount = season.Challenges.Count(challenge => challenge.Order >= 1);
                    <div class="card shadow-sm @(season.IsActive ? "border-success" : "")">
                        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <h5 class="mb-0">@GetSeasonDisplayName(season)</h5>
                                    <span class="badge bg-dark">Season @season.SeasonNumber</span>
                                    @if (season.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </div>

                                <div class="text-muted small d-flex flex-wrap gap-3 mt-1">
                                    <span>
                                        <i class="bi bi-list-check me-1"></i>@visibleChallengeCount @(visibleChallengeCount is 1 ? "challenge" : "challenges")
                                    </span>
                                    @if (season.IsActive)
                                    {
                                        <span>
                                            <i class="bi bi-calendar-event me-1"></i>Start: <strong class="text-dark">@FormatDate(season.StartDate)</strong>
                                        </span>
                                        <span>
                                            <i class="bi bi-calendar-check me-1"></i>End: <strong class="text-dark">@FormatDate(season.EndDate)</strong>
                                        </span>
                                        @if (season.EndDate is { } endDate)
                                        {
                                            <span>
                                                <i class="bi bi-hourglass-split me-1"></i>Ends in: <strong class="text-dark">@FormatTimeUntil(endDate)</strong>
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick='() => Navigation.NavigateTo($"/Seasons/{season.Id}")'>
                                    <i class="bi @(HasPermission(Permissions.EditSeasonsAndChallenges) ? "bi-pencil-square" : "bi-eye") me-1"></i>
                                    @(HasPermission(Permissions.EditSeasonsAndChallenges) ? "Edit" : "View")
                                </button>

                                @if (HasPermission(Permissions.EditSeasonsAndChallenges))
                                {
                                    @if (season.IsActive)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenActivationModal(season)">
                                            <i class="bi bi-calendar-range me-1"></i> Edit Dates
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(disablingSeasonId == season.Id)" @onclick="() => DisableSeasonAsync(season)">
                                            @if (disablingSeasonId == season.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-stop-circle me-1"></i>
                                            }
                                            Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-success btn-sm" @onclick="() => OpenActivationModal(season)">
                                            <i class="bi bi-play-circle me-1"></i> Enable
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(season)">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<DeleteConfirmModal Visible="deleteTargetSeason is not null" IsBusy="isDeletingSeason" ItemName="@(deleteTargetSeason is not null ? GetSeasonDisplayName(deleteTargetSeason) : string.Empty)" ErrorMessage="@deleteErrorMessage" OnCancel="CloseDeleteModal" OnConfirm="ConfirmDeleteSeasonAsync" />

@if (editingActivationSeason is not null)
{
    var otherActive = seasons.FirstOrDefault(s => s.IsActive && s.Id != editingActivationSeason.Id);

    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-dark text-white py-2">
                    <h5 class="modal-title fs-6 mb-0">
                        <i class="bi bi-calendar-range me-2"></i>@(editingActivationSeason.IsActive ? "Edit Season Schedule" : "Enable Season") — @GetSeasonDisplayName(editingActivationSeason)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseActivationModal" disabled="@isSavingActivation"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(activationErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@activationErrorMessage</div>
                    }

                    @if (otherActive is not null)
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Enabling this season will deactivate <strong>@GetSeasonDisplayName(otherActive)</strong> (Season @otherActive.SeasonNumber).
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="seasonStartDate">Start Date (UTC)</label>
                        <input type="datetime-local" id="seasonStartDate" class="form-control form-control-sm" @bind="activationStartUtc" disabled="@isSavingActivation" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold" for="seasonEndDate">End Date (UTC)</label>
                        <input type="datetime-local" id="seasonEndDate" class="form-control form-control-sm" @bind="activationEndUtc" disabled="@isSavingActivation" />
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                        <span class="text-muted small me-1">Quick set:</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@isSavingActivation" @onclick="() => ApplyDurationDays(7)">+7d</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@isSavingActivation" @onclick="() => ApplyDurationDays(14)">+14d</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@isSavingActivation" @onclick="() => ApplyDurationDays(30)">+30d</button>
                    </div>

                    <div class="mt-3 p-2 bg-light border rounded small d-flex justify-content-between align-items-center">
                        <span class="text-muted">Duration</span>
                        <strong class="@(IsModalDurationValid ? "text-dark" : "text-danger")">@GetModalDurationText()</strong>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseActivationModal" disabled="@isSavingActivation">Cancel</button>
                    <button type="button" class="btn @(editingActivationSeason.IsActive ? "btn-primary" : "btn-success") btn-sm" @onclick="SaveActivationAsync" disabled="@isSavingActivation">
                        @if (isSavingActivation)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        @(editingActivationSeason.IsActive ? "Save Dates" : "Enable Season")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showResetModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title text-warning-emphasis">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Reset Seasons Data
                    </h5>
                    <button type="button" class="btn-close" style="filter: invert(0);" @onclick="CloseResetModal" disabled="@isResetting"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> All seasons and challenges will be overwritten.
                    </div>
                    <p class="mb-0">Are you sure you want to reset all seasons data back to default?</p>

                    @if (!string.IsNullOrEmpty(resetErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @resetErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetModal" disabled="@isResetting">Cancel</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmReset" disabled="@isResetting">
                        @if (isResetting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Confirm Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUpdateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-up-circle me-2"></i>Update Seasons Data (v@(latestVersion))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUpdateModal" disabled="@isUpdating"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> Default seasons and challenges will be overwritten.
                    </div>
                    <p class="mb-0">A seasons data update @(string.IsNullOrEmpty(currentVersion) ? (MarkupString)"to version" : (MarkupString)$"from version <strong>v{currentVersion}</strong> to") <strong>v@(latestVersion)</strong> is available. Do you want to apply this update now?</p>

                    @if (!string.IsNullOrEmpty(updateErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @updateErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUpdateModal" disabled="@isUpdating">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmUpdate" disabled="@isUpdating">
                        @if (isUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Apply Update
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? actionErrorMessage;
    private ClaimsPrincipal? user;

    private bool hasUpdateAvailable;
    private string? currentVersion;
    private string? latestVersion;

    private List<SeasonPreviewDto> seasons = [];

    private SeasonPreviewDto? editingActivationSeason;
    private DateTime? activationStartUtc;
    private DateTime? activationEndUtc;
    private bool isSavingActivation;
    private string? activationErrorMessage;
    private Guid? disablingSeasonId;

    private SeasonPreviewDto? deleteTargetSeason;
    private bool isDeletingSeason;
    private string? deleteErrorMessage;

    private bool showResetModal;
    private bool isResetting;
    private string? resetErrorMessage;

    private bool showUpdateModal;
    private bool isUpdating;
    private string? updateErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        await UpdateAuthenticationStateAsync(authenticationStateTask);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> authenticationStateTask)
    {
        var authenticationState = await authenticationStateTask;
        user = authenticationState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var versionTask = Http.GetFromJsonAsync<SeasonsVersionInfo>("api/seasons/data/version");
            var seasonsTask = Http.GetFromJsonAsync<List<SeasonPreviewDto>>("api/seasons");

            await Task.WhenAll(versionTask, seasonsTask);

            var versionInfo = await versionTask;
            if (versionInfo is not null)
            {
                currentVersion = versionInfo.CurrentVersion?.ToString();
                latestVersion = versionInfo.AvailableVersion?.ToString();

                hasUpdateAvailable = versionInfo.AvailableVersion is not null && (versionInfo.CurrentVersion is null || versionInfo.AvailableVersion > versionInfo.CurrentVersion);
            }

            seasons = await seasonsTask ?? [];
        }
        catch (Exception exception)
        {
            errorMessage = $"Failed to load seasons info: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenDeleteModal(SeasonPreviewDto season)
    {
        deleteTargetSeason = season;
        deleteErrorMessage = null;
    }

    private void CloseDeleteModal()
    {
        deleteTargetSeason = null;
        deleteErrorMessage = null;
    }

    private async Task ConfirmDeleteSeasonAsync()
    {
        if (deleteTargetSeason is null)
        {
            return;
        }

        try
        {
            isDeletingSeason = true;
            deleteErrorMessage = null;

            using var response = await Http.DeleteAsync($"api/seasons/{deleteTargetSeason.Id}");
            if (response.IsSuccessStatusCode)
            {
                CloseDeleteModal();
                await LoadDataAsync();
            }
            else
            {
                deleteErrorMessage = "Failed to delete season.";
            }
        }
        catch (Exception exception)
        {
            deleteErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isDeletingSeason = false;
        }
    }

    private void OpenActivationModal(SeasonPreviewDto season)
    {
        editingActivationSeason = season;
        activationErrorMessage = null;

        var nowUtc = DateTime.UtcNow;
        var truncatedNow = new DateTime(nowUtc.Year, nowUtc.Month, nowUtc.Day, nowUtc.Hour, nowUtc.Minute, 0, DateTimeKind.Utc);

        activationStartUtc = season.IsActive ? (season.StartDate?.UtcDateTime ?? truncatedNow) : truncatedNow;
        activationEndUtc = season.IsActive ? (season.EndDate?.UtcDateTime ?? truncatedNow.AddDays(14)) : truncatedNow.AddDays(14);
    }

    private void CloseActivationModal()
    {
        editingActivationSeason = null;
        activationErrorMessage = null;
    }

    private void ApplyDurationDays(int days)
    {
        var nowUtc = DateTime.UtcNow;
        var start = activationStartUtc ?? new DateTime(nowUtc.Year, nowUtc.Month, nowUtc.Day, nowUtc.Hour, nowUtc.Minute, 0, DateTimeKind.Utc);
        activationStartUtc = start;
        activationEndUtc = start.AddDays(days);
    }

    private async Task SaveActivationAsync()
    {
        if (editingActivationSeason is null)
        {
            return;
        }

        activationErrorMessage = null;

        DateTimeOffset? startOffset = activationStartUtc is { } s
            ? new DateTimeOffset(DateTime.SpecifyKind(s, DateTimeKind.Utc))
            : null;
        DateTimeOffset? endOffset = activationEndUtc is { } e
            ? new DateTimeOffset(DateTime.SpecifyKind(e, DateTimeKind.Utc))
            : null;

        if (startOffset is null || endOffset is null)
        {
            activationErrorMessage = "Start date and end date are required.";
            return;
        }

        if (endOffset <= startOffset)
        {
            activationErrorMessage = "End date must be after start date.";
            return;
        }

        if (endOffset <= DateTimeOffset.UtcNow)
        {
            activationErrorMessage = "End date must be in the future.";
            return;
        }

        try
        {
            isSavingActivation = true;

            var command = new UpdateSeasonActivationCommand(true, startOffset, endOffset);
            using var response = await Http.PutAsJsonAsync($"api/seasons/{editingActivationSeason.Id}/activation", command);

            if (response.IsSuccessStatusCode)
            {
                CloseActivationModal();
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                activationErrorMessage = string.IsNullOrWhiteSpace(error) ? "Failed to update season." : error.Trim('"');
            }
        }
        catch (Exception exception)
        {
            activationErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isSavingActivation = false;
        }
    }

    private async Task DisableSeasonAsync(SeasonPreviewDto season)
    {
        try
        {
            disablingSeasonId = season.Id;
            actionErrorMessage = null;

            var command = new UpdateSeasonActivationCommand(false, null, null);
            using var response = await Http.PutAsJsonAsync($"api/seasons/{season.Id}/activation", command);

            if (response.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                actionErrorMessage = string.IsNullOrWhiteSpace(error) ? "Failed to disable season." : error.Trim('"');
            }
        }
        catch (Exception exception)
        {
            actionErrorMessage = $"Failed to disable season: {exception.Message}";
        }
        finally
        {
            disablingSeasonId = null;
        }
    }

    private static string GetSeasonDisplayName(SeasonPreviewDto season)
    {
        if (season.Translations.TryGetValue("en_US", out var en) && !string.IsNullOrWhiteSpace(en.Name))
        {
            return en.Name;
        }

        var first = season.Translations.Values.FirstOrDefault(t => !string.IsNullOrWhiteSpace(t.Name));
        return first?.Name ?? $"Season {season.SeasonNumber}";
    }

    private static string FormatDate(DateTimeOffset? date)
        => date is { } d
            ? d.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC"
            : "Not set";

    private bool IsModalDurationValid
        => activationStartUtc is { } s && activationEndUtc is { } e && e > s;

    private string GetModalDurationText()
    {
        if (activationStartUtc is not { } start || activationEndUtc is not { } end)
        {
            return "Select start and end dates";
        }

        if (end <= start)
        {
            return "End date must be after start date";
        }

        return FormatReadableDuration(start, end);
    }

    private static string FormatTimeUntil(DateTimeOffset endDate)
    {
        var now = DateTime.UtcNow;
        var end = endDate.UtcDateTime;
        if (end <= now)
        {
            return "Ended";
        }

        return FormatReadableDuration(now, end, maxParts: 3);
    }

    private static string FormatReadableDuration(DateTime start, DateTime end, int maxParts = 3)
    {
        var cursor = start;

        var years = 0;
        while (cursor.AddYears(1) <= end)
        {
            cursor = cursor.AddYears(1);
            years++;
        }

        var months = 0;
        while (cursor.AddMonths(1) <= end)
        {
            cursor = cursor.AddMonths(1);
            months++;
        }

        var remaining = end - cursor;
        var weeks = remaining.Days / 7;
        var days = remaining.Days % 7;
        var hours = remaining.Hours;
        var minutes = remaining.Minutes;

        var parts = new List<string>(maxParts);

        void AddPart(int value, string singular, string plural)
        {
            if (value > 0 && parts.Count < maxParts)
            {
                parts.Add(value is 1 ? $"1 {singular}" : $"{value} {plural}");
            }
        }

        AddPart(years, "year", "years");
        AddPart(months, "month", "months");
        AddPart(weeks, "week", "weeks");
        AddPart(days, "day", "days");
        AddPart(hours, "hour", "hours");
        AddPart(minutes, "minute", "minutes");

        return parts.Count > 0 ? string.Join(' ', parts) : "less than a minute";
    }

    private void OpenResetModal()
    {
        resetErrorMessage = null;
        showResetModal = true;
    }

    private void CloseResetModal()
    {
        showResetModal = false;
        resetErrorMessage = null;
    }

    private async Task ConfirmReset()
    {
        try
        {
            isResetting = true;
            resetErrorMessage = null;

            var response = await Http.PostAsync("api/seasons/data/reset", null);
            if (response.IsSuccessStatusCode)
            {
                showResetModal = false;
                await LoadDataAsync();
            }
            else
            {
                resetErrorMessage = "Failed to reset seasons data.";
            }
        }
        catch (Exception exception)
        {
            resetErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isResetting = false;
        }
    }

    private void OpenUpdateModal()
    {
        updateErrorMessage = null;
        showUpdateModal = true;
    }

    private void CloseUpdateModal()
    {
        showUpdateModal = false;
        updateErrorMessage = null;
    }

    private async Task ConfirmUpdate()
    {
        try
        {
            isUpdating = true;
            updateErrorMessage = null;

            var response = await Http.PostAsync("api/seasons/data/update", null);
            if (response.IsSuccessStatusCode)
            {
                showUpdateModal = false;
                await LoadDataAsync();
            }
            else
            {
                updateErrorMessage = "Failed to update seasons data.";
            }
        }
        catch (Exception exception)
        {
            updateErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private bool HasPermission(string permission)
        => user?.HasPermission(permission) ?? false;
}
