@page "/Seasons"
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Seasons
@attribute [Authorize(Policy = Permissions.ViewSeasonsAndChallenges)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Seasons - Solace</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Seasons & Challenges</h2>
            <p class="text-muted mb-0">Manage Minecraft Earth seasons and DAG challenge progression.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (hasUpdateAvailable)
            {
                if (HasPermission(Permissions.EditSeasonsAndChallenges))
                {
                    <button class="btn btn-success" @onclick="OpenUpdateModal">
                        <i class="bi bi-arrow-up-circle me-1"></i> Update to v@(latestVersion)
                    </button>
                }
                else
                {
                    <button class="btn btn-success" disabled>
                        <i class="bi bi-arrow-up-circle me-1"></i> Update to v@(latestVersion) available
                    </button>
                }
            }

            @if (HasPermission(Permissions.EditSeasonsAndChallenges))
            {
                <button class="btn btn-outline-warning" @onclick="OpenResetModal">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Data
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading seasons data...</span>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
    else
    {
        <div class="card p-3">
            <div class="text-muted">
                <span>Database Version: <strong>@(currentVersion ?? "None")</strong></span>
                <span class="ms-3">Static Data Version: <strong>@(latestVersion ?? "Unknown")</strong></span>
            </div>
        </div>
    }
</div>

@if (showResetModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title text-warning-emphasis">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Reset Seasons Data
                    </h5>
                    <button type="button" class="btn-close" style="filter: invert(0);" @onclick="CloseResetModal" disabled="@isResetting"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> All seasons and challenges will be overwritten.
                    </div>
                    <p class="mb-0">Are you sure you want to reset all seasons data back to default?</p>

                    @if (!string.IsNullOrEmpty(resetErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @resetErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseResetModal" disabled="@isResetting">Cancel</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmReset" disabled="@isResetting">
                        @if (isResetting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Confirm Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUpdateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-up-circle me-2"></i>Update Seasons Data (v@(latestVersion))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUpdateModal" disabled="@isUpdating"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Warning:</strong> Default seasons and challenges will be overwritten.
                    </div>
                    <p class="mb-0">A seasons data update @(string.IsNullOrEmpty(currentVersion) ? (MarkupString)"to version" : (MarkupString)$"from version <strong>v{currentVersion}</strong> to") <strong>v@(latestVersion)</strong> is available. Do you want to apply this update now?</p>

                    @if (!string.IsNullOrEmpty(updateErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            @updateErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUpdateModal" disabled="@isUpdating">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmUpdate" disabled="@isUpdating">
                        @if (isUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Apply Update
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private ClaimsPrincipal? user;

    private bool hasUpdateAvailable;
    private string? currentVersion;
    private string? latestVersion;

    private bool showResetModal;
    private bool isResetting;
    private string? resetErrorMessage;

    private bool showUpdateModal;
    private bool isUpdating;
    private string? updateErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        await UpdateAuthenticationStateAsync(authenticationStateTask);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> authenticationStateTask)
    {
        var authenticationState = await authenticationStateTask;
        user = authenticationState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var versionInfo = await Http.GetFromJsonAsync<SeasonsVersionInfo>("api/seasons/data/version");

            if (versionInfo is not null)
            {
                currentVersion = versionInfo.CurrentVersion?.ToString();
                latestVersion = versionInfo.AvailableVersion?.ToString();

                hasUpdateAvailable = versionInfo.AvailableVersion is not null &&
                                     (versionInfo.CurrentVersion is null || versionInfo.AvailableVersion > versionInfo.CurrentVersion);
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Failed to load seasons info: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenResetModal()
    {
        resetErrorMessage = null;
        showResetModal = true;
    }

    private void CloseResetModal()
    {
        showResetModal = false;
        resetErrorMessage = null;
    }

    private async Task ConfirmReset()
    {
        try
        {
            isResetting = true;
            resetErrorMessage = null;

            var response = await Http.PostAsync("api/seasons/data/reset", null);
            if (response.IsSuccessStatusCode)
            {
                showResetModal = false;
                await LoadDataAsync();
            }
            else
            {
                resetErrorMessage = "Failed to reset seasons data.";
            }
        }
        catch (Exception exception)
        {
            resetErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isResetting = false;
        }
    }

    private void OpenUpdateModal()
    {
        updateErrorMessage = null;
        showUpdateModal = true;
    }

    private void CloseUpdateModal()
    {
        showUpdateModal = false;
        updateErrorMessage = null;
    }

    private async Task ConfirmUpdate()
    {
        try
        {
            isUpdating = true;
            updateErrorMessage = null;

            var response = await Http.PostAsync("api/seasons/data/update", null);
            if (response.IsSuccessStatusCode)
            {
                showUpdateModal = false;
                await LoadDataAsync();
            }
            else
            {
                updateErrorMessage = "Failed to update seasons data.";
            }
        }
        catch (Exception exception)
        {
            updateErrorMessage = $"Error: {exception.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private bool HasPermission(string permission)
        => user?.HasPermission(permission) ?? false;
}
