    private SeasonChallengeEditViewModel? _editingChallenge;
    private bool _showChallengeTranslations;
    private string _selectedChallengeLangToAdd = string.Empty;
    private bool _showObjectiveItemPicker;

    private int _textureCacheBuster;

    private SeasonChallengeEditViewModel? ConnectingTarget => _connectingChallengeId is { } id
        ? Model.Challenges.FirstOrDefault(challenge => challenge.Id == id)
        : null;

    private SeasonChallengeEditViewModel? MovingChallenge => _movingChallengeId is { } id
        ? Model.Challenges.FirstOrDefault(challenge => challenge.Id == id)
