    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateAuthenticationStateAsync(AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateAuthenticationStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAuthenticationStateAsync(Task<AuthenticationState> task)
    {
        var authState = await task;
        _user = authState.User;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadInitialDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            try
            {
                if (ServiceProvider.GetService(typeof(CatalogCacheService)) is CatalogCacheService catalogService)
                {
                    _catalog = await catalogService.GetSyncAccessorAsync();
                }
            }
            catch
            {
            }

            if (Id is { } seasonId)
            {
                var dto = await Http.GetFromJsonAsync<SeasonPreviewDto>($"api/seasons/{seasonId}");

                if (dto is null)
                {
                    errorMessage = "Season not found.";
                    return;
                }

                Model = SeasonEditViewModel.FromDto(dto);
            }
            else
            {
                var existingSeasons = await Http.GetFromJsonAsync<List<SeasonPreviewDto>>("api/seasons") ?? [];
                var nextNumber = existingSeasons.Count > 0 ? existingSeasons.Max(s => s.SeasonNumber) + 1 : 1;

                Model = new SeasonEditViewModel
                {
                    SeasonNumber = nextNumber,
                };
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Failed to load season: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

