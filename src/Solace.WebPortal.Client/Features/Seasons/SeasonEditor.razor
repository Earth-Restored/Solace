@page "/Seasons/Create"
@page "/Seasons/{Id:guid}"
@using System.Globalization
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Solace.WebPortal.Client.Features.Catalog
@using Solace.WebPortal.Client.Features.Common
@using Solace.WebPortal.Client.Features.Seasons.Models
@using Solace.WebPortal.Common
@using Solace.WebPortal.Common.Features.Catalog
@using Solace.WebPortal.Common.Features.Seasons
@attribute [Authorize(Policy = Permissions.ViewSeasonsAndChallenges)]
@implements IDisposable
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager
@inject IServiceProvider ServiceProvider

<PageTitle>@(Id is null ? "Create Season" : $"Season {Model.SeasonNumber}") - Solace</PageTitle>

<div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>

            <h3 class="mb-0">
                @(Id is null ? "Create New Season" : CanEdit ? $"Edit Season {Model.SeasonNumber}" : $"View Season {Model.SeasonNumber}")
            </h3>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn @(IsPreviewMode ? "btn-primary" : "btn-outline-primary") btn-sm" @onclick="TogglePreview">
                <i class="bi @(IsPreviewMode ? "bi-pencil-square" : "bi-eye") me-1"></i>
                @(IsPreviewMode ? "Edit Mode" : "Preview Mode")
            </button>

            @if (CanEdit)
            {
                <button type="button" class="btn btn-success btn-sm" disabled="@(isLoading || isSaving)" @onclick="SaveSeasonAsync">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                    }

                    Save Season
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close py-2" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close py-2" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading season...</span>
        </div>
    }
    else if (IsPreviewMode)
    {
        <div class="card shadow-sm">
            <div class="card-body bg-light p-4 d-flex flex-column align-items-center">
                <SeasonPreview Season="@Model.ToPreviewDto()" ShowProgress="false" ShowToolbar="true" TextureUrlResolver="@ResolvePreviewTextureUrl" />
            </div>
        </div>
    }
    else
    {
        var defaultTranslation = Model.EnsureDefaultTranslation();
        var extraSeasonLanguages = Model.Translations.Keys
            .Where(language => !string.Equals(language, "en_US", StringComparison.Ordinal))
            .OrderBy(language => language, StringComparer.Ordinal)
            .ToList();

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-info-circle me-2"></i>Season Details</h5>
                <span class="badge bg-secondary font-monospace">season_@Model.SeasonNumber</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Season Number</label>
                        <input type="number" class="form-control form-control-sm" min="1" @bind="Model.SeasonNumber" readonly="@(!CanEdit)" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label small fw-semibold">Season Name (en_US)</label>
                        <input type="text" class="form-control form-control-sm" @bind="defaultTranslation.Name" placeholder="e.g. Season X: Name" readonly="@(!CanEdit)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Description (en_US)</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="defaultTranslation.Description" placeholder="Shown in the Season Info popup..." readonly="@(!CanEdit)"></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Intro Body (en_US)</label>
                        <input type="text" class="form-control form-control-sm" @bind="defaultTranslation.IntroBody" placeholder="Optional intro message..." readonly="@(!CanEdit)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Progress Text (en_US)</label>
                        <input type="text" class="form-control form-control-sm" @bind="defaultTranslation.EventProgress" placeholder="Optional progress message..." readonly="@(!CanEdit)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Complete Text (en_US)</label>
                        <input type="text" class="form-control form-control-sm" @bind="defaultTranslation.EventComplete" placeholder="Optional completion message..." readonly="@(!CanEdit)" />
                    </div>
                </div>

                <div class="border rounded p-3 bg-white mb-3">
                    <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-2 fw-bold" @onclick="() => _showSeasonTranslations = !_showSeasonTranslations">
                        <i class="bi @(_showSeasonTranslations ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        <span>Additional Translations</span>
                        @if (extraSeasonLanguages.Count > 0)
                        {
                            <span class="badge bg-secondary">@extraSeasonLanguages.Count</span>
                        }
                    </button>

                    @if (_showSeasonTranslations)
                    {
                        <div class="mt-3">
                            @if (CanEdit)
                            {
                                <div class="row g-2 align-items-center mb-3">
                                    <div class="col-sm-6 col-md-4">
                                        <select class="form-select form-select-sm" @bind="_selectedSeasonLangToAdd">
                                            <option value="">-- Add Language --</option>
                                            @foreach (var language in AvailableLanguages)
                                            {
                                                if (!Model.Translations.ContainsKey(language.Code))
                                                {
                                                    <option value="@language.Code">@language.DisplayName (@language.Code)</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddSeasonLanguage" disabled="@string.IsNullOrEmpty(_selectedSeasonLangToAdd)">
                                            <i class="bi bi-plus-lg me-1"></i> Add
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (extraSeasonLanguages.Count is 0)
                            {
                                <div class="text-muted fst-italic small">No additional translations added yet.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var languageCode in extraSeasonLanguages)
                                    {
                                        var translation = Model.Translations[languageCode];
                                        <div class="border rounded p-2 bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="fw-semibold small">
                                                    @GetLanguageDisplayName(languageCode)
                                                    <span class="badge bg-secondary ms-1">@languageCode</span>
                                                </div>
                                                
                                                @if (CanEdit)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" title="Remove Language" @onclick="() => Model.Translations.Remove(languageCode)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <input type="text" class="form-control form-control-sm" @bind="translation.Name" placeholder="Season Name..." readonly="@(!CanEdit)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <input type="text" class="form-control form-control-sm" @bind="translation.Description" placeholder="Description..." readonly="@(!CanEdit)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control form-control-sm" @bind="translation.IntroBody" placeholder="Intro Body..." readonly="@(!CanEdit)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control form-control-sm" @bind="translation.EventProgress" placeholder="Progress Text..." readonly="@(!CanEdit)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control form-control-sm" @bind="translation.EventComplete" placeholder="Complete Text..." readonly="@(!CanEdit)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="border rounded p-3 bg-white">
                    <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-2 fw-bold" @onclick="() => _showExclusiveRewards = !_showExclusiveRewards">
                        <i class="bi @(_showExclusiveRewards ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        <span>Season Exclusive Rewards</span>
                    </button>

                    @if (_showExclusiveRewards)
                    {
                        <div class="mt-3">
                            <RewardsEditor Rewards="Model.ExclusiveRewards" ReadOnly="@(!CanEdit)" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-diagram-3 me-2"></i>Challenges</h5>
                    <span class="badge bg-secondary">@Model.Challenges.Count</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="d-inline-flex align-items-center gap-1"><span class="editor-legend-line editor-legend-and"></span> AND</span>
                    <span class="d-inline-flex align-items-center gap-1"><span class="editor-legend-line editor-legend-or"></span> OR</span>
                </div>
            </div>

            <div class="card-body">
                @if (ConnectingTarget is { } connectingTarget)
                {
                    <div class="alert alert-info py-2 px-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="small">
                            <i class="bi bi-link-45deg me-1"></i>
                            <strong>Connecting prerequisites for #@connectingTarget.Order</strong> — click other challenges to link or unlink them.
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Prerequisite logic">
                                <button type="button" class="btn @(!connectingTarget.PrerequisiteIsOr ? "btn-primary" : "btn-outline-primary")" @onclick="() => connectingTarget.PrerequisiteIsOr = false">
                                    AND (all)
                                </button>
                                <button type="button" class="btn @(connectingTarget.PrerequisiteIsOr ? "btn-warning" : "btn-outline-warning")" @onclick="() => connectingTarget.PrerequisiteIsOr = true">
                                    OR (any)
                                </button>
                            </div>
                            <button type="button" class="btn btn-dark btn-sm" @onclick="ExitInteractiveMode">Done</button>
                        </div>
                    </div>
                }
                else if (MovingChallenge is { } moving)
                {
                    <div class="alert alert-info py-2 px-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="small">
                            <i class="bi bi-arrows-move me-1"></i>
                            <strong>Moving Challenge #@moving.Order</strong> — click any empty slot on the grid to relocate it.
                        </div>
                        <button type="button" class="btn btn-dark btn-sm" @onclick="ExitInteractiveMode">Cancel</button>
                    </div>
                }

                @{
                    var rows = BoardRowCount;
                    var totalCells = rows * SeasonUtils.Columns;
                    var cellMap = Model.Challenges.ToDictionary(c => c.Order);
                    var boardHeight = rows * BoardCellHeight;
                    var connections = BuildEditorConnections(rows);
                }

                <div class="season-editor-board-scroll">
                    <div class="season-editor-board" style="height: @(boardHeight)px;">
                        <svg class="season-editor-svg" width="@BoardWidth" height="@boardHeight" viewBox="0 0 @BoardWidth @boardHeight">
                            @foreach (var edge in connections)
                            {
                                <polyline points="@edge.Points" stroke="@(edge.IsOr ? "var(--editor-edge-or, #fd7e14)" : "var(--editor-edge-and, #0d6efd)")" stroke-width="4" stroke-dasharray="@(edge.IsOr ? "8 5" : "none")" fill="none" stroke-linejoin="miter" stroke-linecap="square" opacity="@(edge.Highlighted ? "1" : "0.7")" />
                            }
                        </svg>

                        <div class="season-editor-grid">
                            @for (var cellIndex = 0; cellIndex < totalCells; cellIndex++)
                            {
                                int cellIndexLocal = cellIndex;
                                if (cellIndexLocal is 0)
                                {
                                    <div class="editor-cell editor-cell-reserved">
                                        <span class="text-muted small">Slot 0<br />(Reserved)</span>
                                    </div>
                                }
                                else if (cellMap.TryGetValue(cellIndexLocal, out var challenge))
                                {
                                    var isConnectionTarget = _connectingChallengeId == challenge.Id;
                                    var isMoving = _movingChallengeId == challenge.Id;
                                    var isLinkedPrerequisite = ConnectingTarget is not null && ConnectingTarget.PrerequisiteIds.Contains(challenge.Id);
                                    var wouldCycle = ConnectingTarget is not null && !isConnectionTarget && !isLinkedPrerequisite && WouldCreateCycle(ConnectingTarget.Id, challenge.Id);

                                    var cardCss = "editor-node-card";
                                    if (isConnectionTarget)
                                    {
                                        cardCss += " is-connect-target";
                                    }
                                    else if (isLinkedPrerequisite)
                                    {
                                        cardCss += " is-linked-prereq";
                                    }
                                    else if (isMoving)
                                    {
                                        cardCss += " is-moving";
                                    }
                                    else if (ConnectingTarget is not null && !wouldCycle)
                                    {
                                        cardCss += " is-connect-candidate";
                                    }
                                    else if (wouldCycle)
                                    {
                                        cardCss += " is-cycle-blocked";
                                    }

                                    <div class="editor-cell">
                                        <div class="@cardCss" @onclick="() => HandleNodeCardClick(challenge, wouldCycle)">
                                            <div class="d-flex justify-content-between align-items-center gap-1 mb-1">
                                                <span class="badge bg-dark">#@challenge.Order</span>
                                                <div class="d-flex align-items-center gap-1">
                                                    @if (challenge.PrerequisiteIds.Count >= 2)
                                                    {
                                                        <button type="button" class="badge border-0 @(challenge.PrerequisiteIsOr ? "bg-warning text-dark" : "bg-primary")" title="Click to toggle AND / OR prerequisite logic" disabled="@(!CanEdit)" @onclick:stopPropagation="true" @onclick="() => challenge.PrerequisiteIsOr = !challenge.PrerequisiteIsOr">
                                                            @(challenge.PrerequisiteIsOr ? "OR" : "AND")
                                                        </button>
                                                    }
                                                    @if (challenge.IsFinalSeasonChallenge || challenge.ObjectiveType is ChallengeObjectiveTypeDto.SeasonCapstone)
                                                    {
                                                        <span class="badge bg-warning text-dark" title="Final / Capstone"><i class="bi bi-star-fill"></i></span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="editor-node-desc" title="@challenge.GetDisplayDescription()">
                                                @challenge.GetDisplayDescription()
                                            </div>

                                            <div class="editor-node-meta text-muted">
                                                <span>@challenge.ObjectiveType</span>
                                                <span>(@challenge.TotalThreshold)</span>
                                            </div>

                                            @if (ConnectingTarget is not null)
                                            {
                                                <div class="mt-auto pt-1 text-center">
                                                    @if (isConnectionTarget)
                                                    {
                                                        <span class="badge bg-primary w-100">Target Node</span>
                                                    }
                                                    else if (isLinkedPrerequisite)
                                                    {
                                                        <span class="badge bg-success w-100"><i class="bi bi-check-lg me-1"></i>Prerequisite (click to unlink)</span>
                                                    }
                                                    else if (wouldCycle)
                                                    {
                                                        <span class="badge bg-secondary w-100">Cycle blocked</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-outline-primary text-primary border border-primary w-100">+ Link Prerequisite</span>
                                                    }
                                                </div>
                                            }
                                            else if (CanEdit)
                                            {
                                                <div class="editor-node-actions mt-auto pt-1" @onclick:stopPropagation="true">
                                                    <button type="button" class="btn btn-outline-secondary btn-xs" title="Edit Challenge" @onclick="() => OpenChallengeEditor(challenge)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-primary btn-xs" title="Connect Prerequisites" @onclick="() => StartConnectMode(challenge.Id)">
                                                        <i class="bi bi-link-45deg"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-info btn-xs" title="Move to Another Slot" @onclick="() => StartMoveMode(challenge.Id)">
                                                        <i class="bi bi-arrows-move"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger btn-xs ms-auto" title="Delete Challenge" @onclick="() => DeleteChallenge(challenge)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="editor-cell">
                                        @if (CanEdit)
                                        {
                                            <button type="button" class="editor-empty-slot @(MovingChallenge is not null ? "is-move-target" : "")" @onclick="() => HandleEmptyCellClick(cellIndexLocal)">
                                                @if (MovingChallenge is not null)
                                                {
                                                    <i class="bi bi-box-arrow-in-down d-block fs-5"></i>
                                                    <span>Move to #@cellIndexLocal</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-plus-circle d-block fs-5"></i>
                                                    <span>Add #@cellIndexLocal</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="editor-empty-slot editor-empty-slot-readonly">
                                                <span class="text-muted small">#@cellIndexLocal</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-2 fw-bold fs-6" @onclick="() => _showTextures = !_showTextures">
                    <i class="bi @(_showTextures ? "bi-chevron-down" : "bi-chevron-right")"></i>
                    <span><i class="bi bi-images me-1"></i>Season Textures</span>
                    @if (Model.TextureOverrides.Count > 0)
                    {
                        <span class="badge bg-info text-dark">@Model.TextureOverrides.Count modified</span>
                    }
                </button>
                <span class="text-muted small">PNG files up to 2 MB</span>
            </div>

            @if (_showTextures)
            {
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_textureErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@_textureErrorMessage</div>
                    }

                    @foreach (var group in TextureSlots.GroupBy(s => s.Category, StringComparer.Ordinal))
                    {
                        <h6 class="fw-bold small text-uppercase text-muted mt-2 mb-2">@group.Key (@group.Count())</h6>
                        <div class="row g-3 mb-3">
                            @foreach (var slot in group)
                            {
                                var isModified = Model.TextureOverrides.ContainsKey(slot.FileName);
                                var previewUrl = ResolvePreviewTextureUrl(slot.FileName);

                                <div class="col-12 col-md-6 col-lg-4" @key="slot.FileName">
                                    <div class="card h-100 @(isModified ? "border-primary" : "")">
                                        <div class="card-body p-3 d-flex flex-column gap-2">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div class="min-w-0">
                                                    <div class="fw-bold small text-truncate">@slot.DisplayName</div>
                                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">@slot.FileName</div>
                                                </div>
                                                <span class="badge bg-secondary-subtle text-dark border flex-shrink-0">@slot.ExpectedSize</span>
                                            </div>

                                            <div class="text-muted" style="font-size: 0.75rem;">@slot.Description</div>

                                            <div class="season-texture-thumb border rounded d-flex align-items-center justify-content-center p-2 bg-dark-subtle">
                                                <img src="@previewUrl" alt="@slot.DisplayName" onerror="this.onerror=null; this.src='/static/missing_texture.png';" style="max-width: 100%; max-height: 90px; object-fit: contain; image-rendering: pixelated;" />
                                            </div>

                                            @if (CanEdit)
                                            {
                                                <div class="d-flex align-items-center gap-2 mt-auto">
                                                    <label class="btn btn-outline-primary btn-sm flex-grow-1 mb-0">
                                                        <i class="bi bi-upload me-1"></i> Replace
                                                        <InputFile OnChange="args => HandleTextureUploadAsync(slot.FileName, args)" accept=".png,image/png" class="d-none" />
                                                    </label>
                                                    @if (isModified)
                                                    {
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" title="Revert local upload" @onclick="() => RevertTextureOverride(slot.FileName)">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_editingChallenge is not null)
{
    var challenge = _editingChallenge;
    var defaultChallengeTranslation = challenge.EnsureDefaultTranslation();
    var extraChallengeLangs = challenge.Translations.Keys
        .Where(language => !string.Equals(language, "en_US", StringComparison.Ordinal))
        .OrderBy(language => language, StringComparer.Ordinal)
        .ToList();
    ItemDto? objectiveTargetItem = null;
    if (challenge.ObjectiveTarget is { } targetId)
    {
        _catalog?.TryGetItem(targetId, out objectiveTargetItem);
    }

    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55); z-index: 1050;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg">
                <div class="modal-header py-2 bg-dark text-white">
                    <h5 class="modal-title fs-6 mb-0">
                        <i class="bi bi-sliders me-2"></i>@(CanEdit ? "Edit" : "View") Challenge #@challenge.Order
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseChallengeEditor"></button>
                </div>

                <div class="modal-body d-flex flex-column gap-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Objective Type</label>
                            <select class="form-select form-select-sm" @bind="challenge.ObjectiveType" disabled="@(!CanEdit)">
                                @foreach (var objType in Enum.GetValues<ChallengeObjectiveTypeDto>())
                                {
                                    <option value="@objType">@objType</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Threshold</label>
                            <input type="number" class="form-control form-control-sm" min="1" @bind="challenge.TotalThreshold" readonly="@(!CanEdit)" />
                        </div>
                        <div class="col-md-5 d-flex align-items-end">
                            <div class="form-check mb-1">
                                <input type="checkbox" class="form-check-input" id="finalChallengeCheck" @bind="challenge.IsFinalSeasonChallenge" disabled="@(!CanEdit)" />
                                <label class="form-check-label small fw-semibold" for="finalChallengeCheck">Final Season Challenge</label>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label small fw-semibold mb-1">Objective Target Item (optional)</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" disabled value="@(challenge.ObjectiveTarget is null ? "Any target" : (objectiveTargetItem is not null ? $"{objectiveTargetItem.Name} ({objectiveTargetItem.Id})" : challenge.ObjectiveTarget.Value.ToString()))" />
                            @if (CanEdit)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => _showObjectiveItemPicker = true">
                                    <i class="bi bi-search me-1"></i> Select
                                </button>
                                @if (challenge.ObjectiveTarget is not null)
                                {
                                    <button type="button" class="btn btn-outline-danger" title="Clear target" @onclick="() => challenge.ObjectiveTarget = null">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <div class="border rounded p-3 bg-light">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="small fw-bold">Prerequisites</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn @(!challenge.PrerequisiteIsOr ? "btn-primary" : "btn-outline-primary")" disabled="@(!CanEdit)" @onclick="() => challenge.PrerequisiteIsOr = false">
                                    AND (all required)
                                </button>
                                <button type="button" class="btn @(challenge.PrerequisiteIsOr ? "btn-warning" : "btn-outline-warning")" disabled="@(!CanEdit)" @onclick="() => challenge.PrerequisiteIsOr = true">
                                    OR (any required)
                                </button>
                            </div>
                        </div>

                        @{
                            var otherChallenges = Model.Challenges.Where(challenge => challenge.Id != challenge.Id).OrderBy(challenge => challenge.Order).ToList();
                        }
                        @if (otherChallenges.Count is 0)
                        {
                            <div class="text-muted small fst-italic">Add more challenges to link prerequisites.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var candidate in otherChallenges)
                                {
                                    var isLinked = challenge.PrerequisiteIds.Contains(candidate.Id);
                                    var cycleBlocked = !isLinked && WouldCreateCycle(challenge.Id, candidate.Id);
                                    <button type="button" class="btn btn-sm @(isLinked ? "btn-success" : "btn-outline-secondary")" disabled="@(!CanEdit || cycleBlocked)" title="@(cycleBlocked ? "Linking this challenge would create a cycle" : candidate.GetDisplayDescription())" @onclick="() => TogglePrerequisite(challenge, candidate.Id)">
                                        <i class="bi @(isLinked ? "bi-check-circle-fill" : "bi-plus-circle") me-1"></i>
                                        #@candidate.Order — @Truncate(candidate.GetDisplayDescription(), 24)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="border rounded p-3">
                        <div class="fw-bold small mb-2">Challenge Text (en_US)</div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Description (single)</label>
                                <input type="text" class="form-control form-control-sm" @bind="defaultChallengeTranslation.Description" placeholder="e.g. Collect a tappable" readonly="@(!CanEdit)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Description (multiple — use <code>%d</code>)</label>
                                <input type="text" class="form-control form-control-sm" @bind="defaultChallengeTranslation.DescriptionMultiple" placeholder="e.g. Collect %d tappables" readonly="@(!CanEdit)" />
                            </div>
                        </div>

                        <div class="mt-2">
                            <button type="button" class="btn btn-link p-0 text-decoration-none text-dark d-flex align-items-center gap-1 small fw-bold" @onclick="() => _showChallengeTranslations = !_showChallengeTranslations">
                                <i class="bi @(_showChallengeTranslations ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                <span>Additional Translations (@extraChallengeLangs.Count)</span>
                            </button>

                            @if (_showChallengeTranslations)
                            {
                                <div class="mt-2">
                                    @if (CanEdit)
                                    {
                                        <div class="d-flex gap-2 mb-2">
                                            <select class="form-select form-select-sm w-auto" @bind="_selectedChallengeLangToAdd">
                                                <option value="">-- Add Language --</option>
                                                @foreach (var language in AvailableLanguages)
                                                {
                                                    if (!challenge.Translations.ContainsKey(language.Code))
                                                    {
                                                        <option value="@language.Code">@language.DisplayName (@language.Code)</option>
                                                    }
                                                }
                                            </select>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => AddChallengeLanguage(challenge)" disabled="@string.IsNullOrEmpty(_selectedChallengeLangToAdd)">
                                                <i class="bi bi-plus-lg me-1"></i> Add
                                            </button>
                                        </div>
                                    }

                                    @foreach (var languageCode in extraChallengeLangs)
                                    {
                                        var translation = challenge.Translations[languageCode];
                                        <div class="row g-2 align-items-center mb-2 bg-light p-2 rounded border">
                                            <div class="col-md-3 small fw-semibold">
                                                @GetLanguageDisplayName(languageCode)
                                                <span class="badge bg-secondary ms-1">@languageCode</span>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" class="form-control form-control-sm" @bind="translation.Description" placeholder="Single..." readonly="@(!CanEdit)" />
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" class="form-control form-control-sm" @bind="translation.DescriptionMultiple" placeholder="Multiple (%d)..." readonly="@(!CanEdit)" />
                                            </div>

                                            @if (CanEdit)
                                            {
                                                <div class="col-md-1 text-end">
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => challenge.Translations.Remove(languageCode)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="border rounded p-3">
                        <div class="fw-bold small mb-2">Rewards</div>
                        <RewardsEditor Rewards="challenge.Rewards" ReadOnly="@(!CanEdit)" />
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CloseChallengeEditor">Done</button>
                </div>
            </div>
        </div>
    </div>
}

<ItemPickerModal Visible="_showObjectiveItemPicker" Title="Select Objective Target Item" ConfirmText="Select Target" ShowQuantity="false" OnCancel="() => _showObjectiveItemPicker = false" OnItemSelected="HandleObjectiveTargetSelected" />

@code {
