    private void DeleteChallenge(SeasonChallengeEditViewModel challenge)
    {
        Model.Challenges.Remove(challenge);

        foreach (var other in Model.Challenges)
        {
            other.PrerequisiteIds.Remove(challenge.Id);
        }

        if (_connectingChallengeId == challenge.Id)
        {
            _connectingChallengeId = null;
        }

        if (_movingChallengeId == challenge.Id)
        {
            _movingChallengeId = null;
        }

        if (_editingChallenge == challenge)
        {
            _editingChallenge = null;
        }
    }

    private void TogglePrerequisite(SeasonChallengeEditViewModel target, Guid prereqId)
    {
        if (target.Id == prereqId)
        {
            return;
        }

        if (target.PrerequisiteIds.Contains(prereqId))
        {
            target.PrerequisiteIds.Remove(prereqId);
        }
        else if (!WouldCreateCycle(target.Id, prereqId))
        {
            target.PrerequisiteIds.Add(prereqId);
        }
    }

    private bool WouldCreateCycle(Guid targetId, Guid candidatePrereqId)
    {
        if (targetId == candidatePrereqId)
        {
            return true;
        }

        var challengeById = Model.Challenges.ToDictionary(challenge => challenge.Id);
        var visited = new HashSet<Guid>();
        var stack = new Stack<Guid>();
        stack.Push(candidatePrereqId);

        while (stack.Count > 0)
        {
            var current = stack.Pop();

            if (current == targetId)
            {
                return true;
            }

            if (!visited.Add(current))
            {
                continue;
            }

            if (challengeById.TryGetValue(current, out var challenge))
            {
                foreach (var next in challenge.PrerequisiteIds)
                {
                    stack.Push(next);
                }
            }
        }

        return false;
    }

    private void HandleObjectiveTargetSelected((ItemDto Item, int Quantity) selection)
    {
        if (_editingChallenge is not null)
        {
            _editingChallenge.ObjectiveTarget = selection.Item.Id;
        }

        _showObjectiveItemPicker = false;
    }

    private async Task HandleTextureUploadAsync(string fileName, InputFileChangeEventArgs args)
    {
        _textureErrorMessage = null;
        var file = args.File;
        if (file is null)
        {
            return;
        }

        if (!file.Name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) && !string.Equals(file.ContentType, "image/png", StringComparison.OrdinalIgnoreCase))
        {
            _textureErrorMessage = $"'{file.Name}' must be a .png image.";
            return;
        }

        if (file.Size > MaxTextureFileSize)
        {
            _textureErrorMessage = $"'{file.Name}' exceeds the 2 MB size limit.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxTextureFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            Model.TextureOverrides[fileName] = bytes;
            Model.TexturePreviewDataUrls[fileName] = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception exception)
        {
            _textureErrorMessage = $"Failed to read '{file.Name}': {exception.Message}";
        }
    }

    private void RevertTextureOverride(string fileName)
    {
        Model.TextureOverrides.Remove(fileName);
        Model.TexturePreviewDataUrls.Remove(fileName);
    }

    private string ResolvePreviewTextureUrl(string fileName)
    {
        if (Model.TexturePreviewDataUrls.TryGetValue(fileName, out var dataUrl))
        {
            return dataUrl;
        }

        var url = $"/static/genoa-textures/ui/seasons/season_{Model.SeasonNumber}/{Uri.EscapeDataString(fileName)}";
        return _textureCacheBuster > 0 ? $"{url}?v={_textureCacheBuster}" : url;
    }

    private List<EditorConnectionVisual> BuildEditorConnections(int rows)
    {
        if (Model.Challenges.Count is 0)
        {
            return [];
        }

        var totalCells = rows * SeasonUtils.Columns;
        var occupied = Model.Challenges.Select(challenge => challenge.Order).ToHashSet();
        var emptyCells = new HashSet<int>();
        for (var i = 0; i < totalCells; i++)
        {
            if (!occupied.Contains(i))
            {
                emptyCells.Add(i);
            }
        }

        var byId = Model.Challenges.ToDictionary(challenge => challenge.Id);
        var result = new List<EditorConnectionVisual>();

        foreach (var node in Model.Challenges)
        {
            foreach (var prereqId in node.PrerequisiteIds)
            {
                if (!byId.TryGetValue(prereqId, out var prereq))
                {
                    continue;
                }

                var path = SeasonUtils.ComputeConnectionPath(node.Order, prereq.Order, emptyCells);
                var scaledPoints = path
                    .Select(point => (point.X / SeasonUtils.CellSize * BoardCellWidth, point.Y / SeasonUtils.CellSize * BoardCellHeight))
                    .ToList();

                var highlighted = _connectingChallengeId is null || _connectingChallengeId == node.Id;
                result.Add(new EditorConnectionVisual(
                    SeasonUtils.PathToSvg(scaledPoints),
                    node.PrerequisiteIsOr && node.PrerequisiteIds.Count >= 2,
                    highlighted));
            }
        }

        return result;
    }

    private async Task SaveSeasonAsync()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            isSaving = true;
            var command = Model.ToSaveCommand();

            HttpResponseMessage response;
            if (Id is { } seasonId)
            {
                response = await Http.PutAsJsonAsync($"api/seasons/{seasonId}", command);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/seasons", command);
            }

            using (response)
            {
                if (response.IsSuccessStatusCode)
                {
                    var saved = await response.Content.ReadFromJsonAsync<SeasonPreviewDto>();
                        
                    if (saved is not null)
                    {
                        var hadTextureUploads = Model.TextureOverrides.Count > 0;
                        Model = SeasonEditViewModel.FromDto(saved);
                        if (hadTextureUploads)
                        {
                            _textureCacheBuster++;
                        }

                        if (Id is null)
                        {
                            NavManager.NavigateTo($"/Seasons/{saved.Id}", replace: true);
                        }
                    }

                    successMessage = "Season saved successfully.";
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    errorMessage = string.IsNullOrWhiteSpace(error) ? "Failed to save season." : error.Trim('"');
                }
            }
        }
        catch (Exception exception)
        {
            errorMessage = $"Failed to save season: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string GetLanguageDisplayName(string code)
        => SeasonLanguageConstants.LanguageNames.TryGetValue(code, out var name) ? name : code;

    private static string Truncate(string text, int maxLength)
        => text.Length <= maxLength ? text : text[..(maxLength - 1)] + "…";
}
