@using System.Diagnostics
@using System.Net.Http.Json
@using System.Numerics
@using Microsoft.JSInterop
@using Solace.WebPortal.Common.Features.Buildplates

@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ILogger<BuildplatePreview> Logger
@implements IAsyncDisposable

<div @ref="_previewContainer" class="bg-dark text-secondary d-flex align-items-center justify-content-center position-relative preview-container" style="height: 220px; overflow: hidden;">
    @if (_isPreviewLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center w-75">
            <div class="text-info mb-2 fw-bold text-center small">
                @(_progressStatus ?? "Loading 3D preview...")
            </div>
            <div class="progress w-100 bg-secondary bg-opacity-25" style="height: 4px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: @((int)(_currentProgress * 100))%; transition: width 0.2s ease;" aria-valuenow="@((int)(_currentProgress * 100))" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>

            @if (_currentProgress > 0)
            {
                <div class="text-info small mt-1" style="font-size: 0.75rem;">
                    @(double.Round(_currentProgress * 100, 1))%
                </div>
            }
        </div>
    }
    else if (_isPreviewFailed)
    {
        <div class="text-danger d-flex flex-column align-items-center">
            <i class="bi bi-x-circle fs-3 mb-1"></i>
            <span class="small fw-bold">Preview unavailable</span>
        </div>
    }
    else if (_previewDataUri is not null)
    {
        <div @ref="_threeJsContainer" class="w-100 h-100"></div>
    }

    @if (DisplayScale is not null)
    {
        <span class="position-absolute top-0 start-0 m-2 badge bg-info">
            @DisplayScale
        </span>
    }

    @if (IsNight is { } isNight)
    {
        <span class="position-absolute top-0 end-0 m-2 badge @(isNight ? "bg-secondary" : "bg-info")">
            @(isNight ? "Night" : "Day")
        </span>
    }

    @if (!_isPreviewLoading)
    {
        <div class="position-absolute bottom-0 start-0 m-2 d-flex gap-1">
            <button class="btn btn-sm btn-light opacity-75 hover-opacity-100" @onclick="RefreshPreviewAsync" title="Refresh Preview">
                <i class="bi bi-arrow-clockwise"></i>
            </button>

            @if (_previewDataUri is not null)
            {
                <button class="btn btn-sm @(_isFirstPerson ? "btn-info" : "btn-light") opacity-75 hover-opacity-100" @onclick="ToggleControlModeAsync" title="Toggle Free Fly Mode">
                    <i class="bi @(_isFirstPerson ? "bi-controller" : "bi-box")"></i>
                </button>
            }
        </div>

        @if (_isFirstPerson && _previewDataUri is not null)
        {
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-2" style="pointer-events: none; z-index: 10;">
                <div class="bg-black text-white border border-secondary px-3 py-1 rounded shadow text-center" style="font-size: 0.8rem; white-space: nowrap;">
                    <span class="fw-bold text-info">WASD</span> Move &bull;
                    <span class="fw-bold text-info">Space/Shift</span> Up/Down &bull;
                    <span class="fw-bold text-info">Tab</span> Exit
                </div>
            </div>
        }

        if (_previewDataUri is not null)
        {
            <button class="btn btn-sm btn-light position-absolute bottom-0 end-0 m-2 opacity-75 hover-opacity-100" @onclick="ToggleFullscreen" title="Toggle Fullscreen">
                <i class="bi bi-arrows-fullscreen"></i>
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required Guid BuildplateId { get; set; }
    [Parameter, EditorRequired] public required bool IsTemplate { get; set; }
    [Parameter] public Guid? PlayerId { get; set; }
    [Parameter] public int? BlocksPerMeter { get; set; }
    [Parameter] public bool? IsNight { get; set; }

    private ElementReference _previewContainer;
    private ElementReference _threeJsContainer;

    private bool _isPreviewLoading = true;
    private bool _isPreviewFailed = false;
    private string? _previewDataUri;
    private Bounds _previewBounds;
    private bool _isModelImported = false;
    private bool _isCurrentlyLoadingTask = false;
    private bool _isFirstPerson = false;
    private bool _hasStartedLoading = false;

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<BuildplatePreview>? _dotNetRef;

    private double _currentProgress = 0;
    private string? _progressStatus = "Queued...";
    private CancellationTokenSource? _progressCts;

    private string? DisplayScale
    {
        get
        {
            if (BlocksPerMeter is null)
            {
                return null;
            }

            float scaleVal = 1f / BlocksPerMeter.Value;
            return scaleVal >= 1 ? $"1:{scaleVal:0.##}" : $"{(1 / scaleVal):0.##}:1";
        }
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
#pragma warning disable BL0016
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("importShim", "./Features/Buildplates/BuildplatePreview.razor.js");
#pragma warning restore BL0016

#pragma warning disable BL0016
            await _jsModule.InvokeVoidAsync("setupLazyLoad", _previewContainer, _dotNetRef);
#pragma warning restore BL0016
        }

        if (_previewDataUri is not null && !_isModelImported && _jsModule is not null)
        {
            _isModelImported = true;

            try
            {
                await _jsModule.InvokeVoidAsync("initThreeJs", _threeJsContainer, _previewDataUri, _previewBounds, IsNight, _dotNetRef);
            }
            catch (Exception exception)
            {
                Console.WriteLine(exception);
                Logger.LogError(exception, "Failed to initialize Three.js viewer for {Id}.", BuildplateId);
                _isPreviewFailed = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public async Task StartLoadingAsync()
    {
        if (_hasStartedLoading)
        {
            return;
        }

        _hasStartedLoading = true;

        if (_previewDataUri is null && !_isPreviewFailed && _isPreviewLoading && !_isCurrentlyLoadingTask)
        {
            ResetProgress();
            _isCurrentlyLoadingTask = true;
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                try
                {
                    await LoadPreviewAsync();
                }
                finally
                {
                    _isCurrentlyLoadingTask = false;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    private async Task ToggleControlModeAsync()
    {
        if (_jsModule is not null && _previewDataUri is not null)
        {
            _isFirstPerson = !_isFirstPerson;
#pragma warning disable BL0016
            await _jsModule.InvokeVoidAsync("setControlMode", _threeJsContainer, _isFirstPerson);
#pragma warning restore BL0016
        }
    }

    [JSInvokable]
    public async Task ExitFirstPersonMode()
    {
        if (_isFirstPerson)
        {
            _isFirstPerson = false;
            StateHasChanged();

            if (_jsModule is not null)
            {
#pragma warning disable BL0016
                await _jsModule.InvokeVoidAsync("setControlMode", _threeJsContainer, false);
#pragma warning restore BL0016
            }
        }
    }

    private async Task RefreshPreviewAsync()
    {
        if (_isCurrentlyLoadingTask)
        {
            return;
        }

        if (_jsModule is not null && _previewDataUri is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("dispose", _threeJsContainer);
            }
            catch
            {
            }
        }

        _isFirstPerson = false;
        ResetProgress();
        _isCurrentlyLoadingTask = true;
        _isPreviewLoading = true;
        _isPreviewFailed = false;
        _isModelImported = false;
        _previewDataUri = null;

        _ = Task.Run(async () =>
        {
            try
            {
                await LoadPreviewAsync(getFromCache: false);
            }
            finally
            {
                _isCurrentlyLoadingTask = false;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void ResetProgress()
    {
        _progressCts?.Cancel();
        _progressCts?.Dispose();
        _progressCts = new CancellationTokenSource();

        _currentProgress = 0;
        _progressStatus = "Initializing...";
    }

    private async Task LoadPreviewAsync(bool getFromCache = true)
    {
        try
        {
            var forceRefresh = !getFromCache;
            var url = $"/api/buildplates/{BuildplateId}/preview?isTemplate={IsTemplate}&forceRefresh={forceRefresh}";
            if (PlayerId.HasValue)
            {
                url += $"&playerId={PlayerId.Value}";
            }

            var stream = Http.GetFromJsonAsAsyncEnumerable<BuildplatePreviewResponse>(url, _progressCts!.Token);

            await foreach (var update in stream)
            {
                if (update is null)
                {
                    continue;
                }

                if (update.Data is { } data)
                {
                    _currentProgress = 1.00;
                    _progressStatus = "Preparing preview";
                    await InvokeAsync(StateHasChanged);

                    await Task.Delay(200);
                    _previewDataUri = data.DataUri;
                    _previewBounds = data.Bounds;
                }
                else
                {
                    _currentProgress = double.Clamp(update.Progress, 0.00, 1.00);
                    if (update.StatusMessage is not null)
                    {
                        _progressStatus = update.StatusMessage;
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }

            if (_previewDataUri is null)
            {
                Console.WriteLine("No preview data received");
                _isPreviewFailed = true;
            }
        }
        catch (Exception exception) when (exception is not TaskCanceledException)
        {
            Console.WriteLine(exception);
            Logger.LogError(exception, "Preview fetch failed for Buildplate ID {Id}", BuildplateId);
            _isPreviewFailed = true;
        }
        finally
        {
            _progressCts?.Cancel();
            _isPreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleFullscreen()
    {
        if (_jsModule is not null)
        {
#pragma warning disable BL0016
            await _jsModule.InvokeVoidAsync("toggleFullscreen", _previewContainer);
#pragma warning restore BL0016
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _dotNetRef?.Dispose();
            _progressCts?.Cancel();
            _progressCts?.Dispose();

            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("cleanupLazyLoad", _previewContainer);
                await _jsModule.InvokeVoidAsync("dispose", _threeJsContainer);
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Error during disposal of {Id}", BuildplateId);
        }
    }
}