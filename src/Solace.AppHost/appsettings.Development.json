{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Shared": {
    "AcceptMinecraftEula": false, // if you accept the minecraft EULA (https://www.minecraft.net/en-us/eula), change this to true (required for buildplates and FixUpBuildplatesOnImport)
    "FixUpBuildplatesOnImport": true,
    "StaticDataPath": "../../staticdata",
    "ResolvePaths": true,
    "Captcha": {
      "Provider": "NoOp",
      "CloudflareTurnstileSiteKey": "",
      "CloudflareTurnstileSecretKey": ""
    },
    "PublicEndpoints": {
      "WebPortal": "",
      "Locator": "",
      "AuthServer": "",
      "ApiServer": "",
      "Cdn": ""
    },
    "Oidc": {
      "WebPortal": {
        "SigningCertPath": "",
        "SigningCertPassword": "",
        "EncryptionCertPath": "",
        "EncryptionCertPassword": "",
        "AuthServer": {
          "ClientId": "solace-auth-server",
          "ClientSecret": "development_secret_change_in_prod",
          "DisplayName": "Solace"
        }
      }
    }
  },
  "ObjectStore": {
    "DataDirectory": "../../data/object_store"
  },
  "Locator": {
    "Port": 8080
  },
  "AuthServer": {
    "Port": 8088,
    "Authentication": {
      "Login": {
        "SoapHeaderValidityMinutes": 1,
        "UserTokenValidityMinutes": 10080,
        "DeviceTokenValidityMinutes": 1,
        "XboxTokenValidityMinutes": 10080
      },
      "XboxLive": {
        "TokenValidityMinutes": 10080
      },
      "PlayfabApi": {
        "EntityTokenValidityMinutes": 1440,
        "SessionTicketValidityMinutes": 1440
      }
    }
  },
  "Cdn": {
    "Port": 8090
  },
  "ApiServer": {
    "Port": 8089,
    "Authentication": {
      "LocalLoginOnly": true
    }
  },
  "BuildplateLauncher": {
    "PublicEndPoint": "127.0.0.1",
    "BaseInstancePublicPort": 19132,
    "FountainBridgeJarName": "fountain-{{version}}-SNAPSHOT-jar-with-dependencies.jar",
    "FabricJarName": "server-{{version}}.jar",
    "ConnectorPluginJarName": "buildplate-connector-plugin-{{version}}-SNAPSHOT-jar-with-dependencies.jar"
  },
  "TileRenderer": {
    "TileSource": {
      "TileJsonUrl": "https://tiles.openfreemap.org/planet",
      "TileDatabaseConnectionString": ""
    }
  },
  "WebPortal": {
    "Port": 5000,
    "BuildplatePreview": {
      "Enabled": true,
      "GenerationMaxConcurrency": 2
    }
  }
}