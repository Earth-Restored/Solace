{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Shared": {
    "StaticDataPath": "staticdata",
    "ResolvePaths": false,
    "Captcha": {
      "Provider": "NoOp", // options: NoOp, CloudflareTurnstile
      "CloudflareTurnstileSiteKey": "",
      "CloudflareTurnstileSecretKey": ""
    },
    "PublicEndpoints": { // format: <protocol>://<ip/domain>:<optional port>, e.g. https://locator.abc.com:8080
      "WebPortal": "", // optional, used for oidc, if not specified, uses http://localhost:{web portal port}/
      "Locator": "", // optional, displayed in web portal
      "AuthServer": "", // optional, displayed in web portal
      "ApiServer": "", // optional, if not specified, locator uses request protocol and host + api server port
      "Cdn": "" // optional, if not specified, locator uses request protocol and host + cdn port
    },
    "Oidc": {
      // certificates only used in production
      "WebPortal": {
        "SigningCertPath": "./certs/web-portal/oidc-signing-cert.pfx",
        "SigningCertPassword": "",
        "EncryptionCertPath": "./certs/web-portal/oidc-encryption-cert.pfx",
        "EncryptionCertPassword": "",
        "AuthServer": {
          "ClientId": "solace-auth-server",
          "ClientSecret": "development_secret_change_in_prod", // change to random base64 string
          "DisplayName": "Solace"
        }
      }
    }
  },
  "ObjectStore": {
    "DataDirectory": "data/object_store"
  },
  "Locator": {
    "Port": 8080
  },
  "AuthServer": {
    "Port": 8088,
    "Authentication": {
      "Login": {
        "SoapHeaderValidityMinutes": 1,
        "UserTokenValidityMinutes": 10080,
        "DeviceTokenValidityMinutes": 1,
        "XboxTokenValidityMinutes": 10080
      },
      "XboxLive": {
        "TokenValidityMinutes": 10080
      },
      "PlayfabApi": {
        "EntityTokenValidityMinutes": 1440,
        "SessionTicketValidityMinutes": 1440
      }
    }
  },
  "Cdn": {
    "Port": 8090
  },
  "ApiServer": {
    "Port": 8089,
    "Authentication": {
      // setting this to false means anyone can login into any account!!!
      "LocalLoginOnly": true // if set to true, only local accounts are allowed; otherwise accounts are not verified, so microsoft login works
    }
  },
  "BuildplateLauncher": {
    "PublicEndPoint": "127.0.0.1", // public endpoint of the buildplate server, without protocol
    "BaseInstancePublicPort": 19132, // starting public port for buildplate instance, subsequent instances use increments
    "FountainBridgeJarName": "fountain-{{version}}-SNAPSHOT-jar-with-dependencies.jar",
    "FabricJarName": "fabric-server-mc.1.20.4-loader.0.15.10-launcher.1.0.1.jar",
    "ConnectorPluginJarName": "buildplate-connector-plugin-{{version}}-SNAPSHOT-jar-with-dependencies.jar"
  },
  "TileRenderer": {
    "TileSource": { // specify one of these to enable the map
      "TileJsonUrl": "https://tiles.openfreemap.org/planet", // url to "tile json" e.g. https://tiles.openfreemap.org/planet" or "https://api.maptiler.com/tiles/v3/tiles.json?key=XXX"
      "TileDatabaseConnectionString": "" // connection string to a PostgreSQL database (PostGIS 3+ enabled) with osm2pgsql imported data
    }
  },
  "WebPortal": {
    "Port": 80,
    "BuildplatePreview": { // 3d buildplate preview
      "Enabled": true, // whether buildplate previews can be generated
      "GenerationMaxConcurrency": 2 // how many previews can be generating at a time
    }
  }
}